<exercisegroup cols="2">
<title>Matrix operations involving special forms</title>

<introduction><p>
	Carry out each matrix operation using the patterns discovered in this chapter.
	Reflect on how the patterns in the entries of the matrices involved affect the patterns in the entries of the result.
</p></introduction>


<!-- ops involving scalar -->

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			7 \amp 0 \amp 0 \\
			0 \amp 7 \amp 0 \\
			0 \amp 0 \amp 7
		\end{bmatrix}
		-
		\begin{bmatrix}
			4 \amp 0 \amp 0 \\
			0 \amp 4 \amp 0 \\
			0 \amp 0 \amp 4
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			3 \amp 0 \amp 0 \\
			0 \amp 3 \amp 0 \\
			0 \amp 0 \amp 3
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		7
		\begin{bmatrix}
			4 \amp 0 \amp 0 \\
			0 \amp 4 \amp 0 \\
			0 \amp 0 \amp 4
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			28 \amp  0 \amp  0 \\
			 0 \amp 28 \amp  0 \\
			 0 \amp  0 \amp 28
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		4
		\begin{bmatrix}
			7 \amp 0 \amp 0 \\
			0 \amp 7 \amp 0 \\
			0 \amp 0 \amp 7
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			28 \amp  0 \amp  0 \\
			 0 \amp 28 \amp  0 \\
			 0 \amp  0 \amp 28
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			7 \amp 0 \amp 0 \\
			0 \amp 7 \amp 0 \\
			0 \amp 0 \amp 7
		\end{bmatrix}
		\begin{bmatrix}
			4 \amp 0 \amp 0 \\
			0 \amp 4 \amp 0 \\
			0 \amp 0 \amp 4
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			28 \amp  0 \amp  0 \\
			 0 \amp 28 \amp  0 \\
			 0 \amp  0 \amp 28
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			4 \amp 0 \amp 0 \\
			0 \amp 4 \amp 0 \\
			0 \amp 0 \amp 4
		\end{bmatrix}
		\begin{bmatrix}
			7 \amp 0 \amp 0 \\
			0 \amp 7 \amp 0 \\
			0 \amp 0 \amp 7
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			28 \amp  0 \amp  0 \\
			 0 \amp 28 \amp  0 \\
			 0 \amp  0 \amp 28
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		{
			\begin{bmatrix}
				4 \amp 0 \amp 0 \\
				0 \amp 4 \amp 0 \\
				0 \amp 0 \amp 4
			\end{bmatrix}
		}^3
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			64 \amp  0 \amp  0 \\
			 0 \amp 64 \amp  0 \\
			 0 \amp  0 \amp 64
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		4
		{
			\begin{bmatrix}
				4 \amp 0 \amp 0 \\
				0 \amp 4 \amp 0 \\
				0 \amp 0 \amp 4
			\end{bmatrix}
		}^2
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			64 \amp  0 \amp  0 \\
			 0 \amp 64 \amp  0 \\
			 0 \amp  0 \amp 64
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{bmatrix}
				4 \amp 0 \amp 0 \\
				0 \amp 4 \amp 0 \\
				0 \amp 0 \amp 4
			\end{bmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			4 \amp 0 \amp 0 \\
			0 \amp 4 \amp 0 \\
			0 \amp 0 \amp 4
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{bmatrix}
				1 \amp 0 \amp 0 \\
				0 \amp 1 \amp 0 \\
				0 \amp 0 \amp 1
			\end{bmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			1 \amp 0 \amp 0 \\
			0 \amp 1 \amp 0 \\
			0 \amp 0 \amp 1
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{bmatrix}
				0 \amp 0 \amp 0 \\
				0 \amp 0 \amp 0 \\
				0 \amp 0 \amp 0
			\end{bmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			0 \amp 0 \amp 0 \\
			0 \amp 0 \amp 0 \\
			0 \amp 0 \amp 0
		\end{bmatrix}
	</m></p></answer>
</exercise>


<!-- ops involving diagonal -->

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			5 \amp  0 \amp 0 \\
			0 \amp -1 \amp 0 \\
			0 \amp  0 \amp 3
		\end{abmatrix}
		+
		\begin{abmatrix}{rrr}
			4 \amp  0 \amp  0 \\
			0 \amp -2 \amp  0 \\
			0 \amp  0 \amp -3
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			9 \amp  0 \amp 0 \\
			0 \amp -3 \amp 0 \\
			0 \amp  0 \amp 0
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		-3
		\begin{abmatrix}{rrr}
			5 \amp  0 \amp 0 \\
			0 \amp -1 \amp 0 \\
			0 \amp  0 \amp 3
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-15 \amp 0 \amp  0 \\
			  0 \amp 3 \amp  0 \\
			  0 \amp 0 \amp -9
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			5 \amp  0 \amp 0 \\
			0 \amp -1 \amp 0 \\
			0 \amp  0 \amp 3
		\end{abmatrix}
		\begin{bmatrix}
			\frac{1}{5} \amp 0 \amp 0 \\
			     0      \amp 3 \amp 0 \\
			     0      \amp 0 \amp 2
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			1 \amp  0 \amp 0 \\
			0 \amp -3 \amp 0 \\
			0 \amp  0 \amp 6
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			\frac{1}{5} \amp 0 \amp 0 \\
			     0      \amp 3 \amp 0 \\
			     0      \amp 0 \amp 2
		\end{bmatrix}
		\begin{abmatrix}{rrr}
			5 \amp  0 \amp 0 \\
			0 \amp -1 \amp 0 \\
			0 \amp  0 \amp 3
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			1 \amp  0 \amp 0 \\
			0 \amp -3 \amp 0 \\
			0 \amp  0 \amp 6
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		{
			\begin{abmatrix}{rrrr}
				2 \amp  0 \amp 0 \amp 0 \\
				0 \amp -1 \amp 0 \amp 0 \\
				0 \amp  0 \amp 6 \amp 0 \\
				0 \amp  0 \amp 0 \amp 3
			\end{abmatrix}
		}^5
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{crcc}
			32 \amp  0 \amp   0  \amp  0 \\
			 0 \amp -1 \amp   0  \amp  0 \\
			 0 \amp  0 \amp 7776 \amp  0 \\
			 0 \amp  0 \amp   0  \amp 243
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{abmatrix}{rrrr}
				2 \amp  0 \amp 0 \amp 0 \\
				0 \amp -1 \amp 0 \amp 0 \\
				0 \amp  0 \amp 6 \amp 0 \\
				0 \amp  0 \amp 0 \amp 3
			\end{abmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			2 \amp  0 \amp 0 \amp 0 \\
			0 \amp -1 \amp 0 \amp 0 \\
			0 \amp  0 \amp 6 \amp 0 \\
			0 \amp  0 \amp 0 \amp 3
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			5 \amp  0 \amp 0 \\
			0 \amp -1 \amp 0 \\
			0 \amp  0 \amp 3
		\end{abmatrix}
		+
		\begin{abmatrix}{rrr}
			0 \amp 4 \amp -2 \\
			0 \amp 0 \amp  1 \\
			0 \amp 0 \amp  0
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			5 \amp  4 \amp -2 \\
			0 \amp -1 \amp  1 \\
			0 \amp  0 \amp  3
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-3 \amp 0 \amp 0 \\
			 0 \amp 2 \amp 0 \\
			 0 \amp 0 \amp 4
		\end{abmatrix}
		\begin{abmatrix}{rrr}
			-2 \amp  6 \amp -3 \\
			 3 \amp -3 \amp  7 \\
			-1 \amp  8 \amp -7
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			 6 \amp -18 \amp   9 \\
			 6 \amp - 6 \amp  14 \\
			-4 \amp  32 \amp -28
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-2 \amp  6 \amp -3 \\
			 3 \amp -3 \amp  7 \\
			-1 \amp  8 \amp -7
		\end{abmatrix}
		\begin{abmatrix}{rrr}
			-3 \amp 0 \amp 0 \\
			 0 \amp 2 \amp 0 \\
			 0 \amp 0 \amp 4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			 6 \amp 12 \amp -12 \\
			-9 \amp -6 \amp  28 \\
			 3 \amp 16 \amp -28
		\end{abmatrix}
	</m></p></answer>
</exercise>


<!-- upper/lower triangular -->

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			1 \amp -2 \amp -5 \\
			0 \amp  6 \amp  5 \\
			0 \amp  0 \amp  7
		\end{abmatrix}
		+
		\begin{abmatrix}{rrr}
			6 \amp  1 \amp  5 \\
			0 \amp -3 \amp -3 \\
			0 \amp  0 \amp  4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			7 \amp -1 \amp  0 \\
			0 \amp  3 \amp  2 \\
			0 \amp  0 \amp 11
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			3 \amp  0 \amp 0 \\
			5 \amp -2 \amp 0 \\
			6 \amp  2 \amp 5
		\end{abmatrix}
		-
		\begin{abmatrix}{rrr}
			-5 \amp 0 \amp 0  \\
			 0 \amp 2 \amp 0 \\
			-1 \amp 2 \amp 4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			8 \amp  0 \amp 0 \\
			5 \amp -4 \amp 0 \\
			7 \amp  0 \amp 1
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			3 \amp  0 \amp 0 \\
			5 \amp -2 \amp 0 \\
			6 \amp  2 \amp 5
		\end{abmatrix}
		-
		\begin{bmatrix}
			0 \amp 0 \amp 0 \\
			5 \amp 0 \amp 0 \\
			6 \amp 2 \amp 0
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			3 \amp  0 \amp 0 \\
			0 \amp -2 \amp 0 \\
			0 \amp  0 \amp 5
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		5
		\begin{abmatrix}{rrr}
			1 \amp -2 \amp -5 \\
			0 \amp  6 \amp  5 \\
			0 \amp  0 \amp  7
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			5 \amp -10 \amp -25 \\
			0 \amp  30 \amp  25 \\
			0 \amp   0 \amp  35
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		-4
		\begin{abmatrix}{rrr}
			 3 \amp 0 \amp  0 \\
			-5 \amp 1 \amp  0 \\
			 4 \amp 0 \amp -2
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-12 \amp  0 \amp 0 \\
			 20 \amp -4 \amp 0 \\
			-16 \amp  0 \amp 8
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			3 \amp  0 \amp 0 \\
			5 \amp -2 \amp 0 \\
			6 \amp  2 \amp 5
		\end{abmatrix}
		\begin{abmatrix}{rrr}
			-5 \amp 0 \amp 0  \\
			 0 \amp 2 \amp 0 \\
			-1 \amp 2 \amp 4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-15 \amp  0 \amp  0 \\
			-25 \amp -4 \amp  0 \\
			-35 \amp 14 \amp 20
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			1 \amp -2 \amp -5 \\
			0 \amp  6 \amp  5 \\
			0 \amp  0 \amp  7
		\end{abmatrix}
		\begin{abmatrix}{rrr}
			6 \amp  1 \amp  5 \\
			0 \amp -3 \amp -3 \\
			0 \amp  0 \amp  4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			6 \amp   7 \amp -9 \\
			0 \amp -18 \amp  2 \\
			0 \amp   0 \amp 28
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		{
			\begin{abmatrix}{rrr}
				1 \amp -2 \amp -5 \\
				0 \amp  6 \amp  5 \\
				0 \amp  0 \amp  7
			\end{abmatrix}
		}^2
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			1 \amp -14 \amp -50 \\
			0 \amp  36 \amp  65 \\
			0 \amp   0 \amp  49
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		{
			\begin{abmatrix}{rrr}
				3 \amp  0 \amp 0 \\
				5 \amp -2 \amp 0 \\
				6 \amp  2 \amp 5
			\end{abmatrix}
		}^2
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			 9 \amp 0 \amp  0 \\
			 5 \amp 4 \amp  0 \\
			58 \amp 6 \amp 25
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{abmatrix}{rrr}
				1 \amp -2 \amp -5 \\
				0 \amp  6 \amp  5 \\
				0 \amp  0 \amp  7
			\end{abmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			 1 \amp 0 \amp 0 \\
			-2 \amp 6 \amp 0 \\
			-5 \amp 5 \amp 7
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{abmatrix}{rrr}
				 3 \amp 0 \amp  0 \\
				-5 \amp 1 \amp  0 \\
				 4 \amp 0 \amp -2
			\end{abmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			3 \amp -5 \amp  4 \\
			0 \amp  1 \amp  0 \\
			0 \amp  0 \amp -2
		\end{abmatrix}
	</m></p></answer>
</exercise>


<!-- symmetric -->

<exercise>
	<statement><p><m>\displaystyle
		-2
		\begin{abmatrix}{rrr}
			1 \amp  2 \amp  3 \\
			2 \amp  4 \amp -1 \\
			3 \amp -1 \amp  5
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-2 \amp -4 \amp - 6 \\
			-4 \amp -8 \amp   2 \\
			-6 \amp  2 \amp -10
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\utrans{
			\begin{abmatrix}{rrr}
				 7 \amp -6 \amp 0 \\
				-6 \amp  4 \amp 1 \\
				 0 \amp  1 \amp 5
			\end{abmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			 7 \amp -6 \amp 0 \\
			-6 \amp  4 \amp 1 \\
			 0 \amp  1 \amp 5
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-4 \amp  1 \amp -2 \\
			 1 \amp  2 \amp -3 \\
			-2 \amp -3 \amp  3
		\end{abmatrix}
		-
		\utrans{
			\begin{abmatrix}{rrr}
				-4 \amp  1 \amp -2 \\
				 1 \amp  2 \amp -3 \\
				-2 \amp -3 \amp  3
			\end{abmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			0 \amp 0 \amp 0 \\
			0 \amp 0 \amp 0 \\
			0 \amp 0 \amp 0
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			0 \amp 0 \amp 0 \\
			5 \amp 0 \amp 0 \\
			6 \amp 2 \amp 0
		\end{bmatrix}
		+ \utrans{
			\begin{bmatrix}
				0 \amp 0 \amp 0 \\
				5 \amp 0 \amp 0 \\
				6 \amp 2 \amp 0
			\end{bmatrix}
		}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			0 \amp 5 \amp 6 \\
			5 \amp 0 \amp 2 \\
			6 \amp 2 \amp 0
		\end{bmatrix}
	</m></p></answer>
</exercise>

</exercisegroup>
