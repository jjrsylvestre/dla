<exercisegroup cols="2">
<title>Inverses of special forms</title>

<introduction><p>
	Compute the inverse of each matrix (if possible),
	either by inspection or using <xref ref="procedure-elem-matrices-concepts-inversion-by-row-red" />.
	If you use <xref ref="procedure-elem-matrices-concepts-inversion-by-row-red" />,
	afterward reflect on how the row operations involved guarantee that the result will be the of the same form as the original.
</p></introduction>


<!-- scalar -->

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			3 \amp 0 \amp 0 \\
			0 \amp 3 \amp 0 \\
			0 \amp 0 \amp 3
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			\frac{1}{3} \amp      0      \amp      0      \\
			     0      \amp \frac{1}{3} \amp      0      \\
			     0      \amp      0      \amp \frac{1}{3}
		\end{bmatrix}
	</m></p></answer>
</exercise>


<!-- diagonal -->

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{cccr}
			4 \amp 0 \amp       0      \amp  0 \\
			0 \amp 2 \amp       0      \amp  0 \\
			0 \amp 0 \amp -\frac{1}{6} \amp  0 \\
			0 \amp 0 \amp       0      \amp -7
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{ccrc}
			\frac{1}{4} \amp      0      \amp  0 \amp       0      \\
			     0      \amp \frac{1}{2} \amp  0 \amp       0      \\
			     0      \amp      0      \amp -6 \amp       0      \\
			     0      \amp      0      \amp  0 \amp -\frac{1}{7}
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{cccr}
			4 \amp 0 \amp 0 \amp  0 \\
			0 \amp 2 \amp 0 \amp  0 \\
			0 \amp 0 \amp 0 \amp  0 \\
			0 \amp 0 \amp 0 \amp -7
		\end{abmatrix}
	</m></p></statement>
	<answer><p> Not invertible. </p></answer>
</exercise>


<!-- upper/lower triangular  -->

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			2 \amp  0 \amp  2 \amp  1 \\
			0 \amp  1 \amp -3 \amp -1 \\
			0 \amp  0 \amp -4 \amp -6 \\
			0 \amp  0 \amp  0 \amp  3
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			\frac{1}{2} \amp 0 \amp  \frac{1}{4} \amp  \frac{1}{3} \\
			     0      \amp 1 \amp -\frac{3}{4} \amp -\frac{7}{6} \\
			     0      \amp 0 \amp -\frac{1}{4} \amp -\frac{1}{2} \\
			     0      \amp 0 \amp       0      \amp  \frac{1}{3}
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			2 \amp  0 \amp  2 \amp  1 \\
			0 \amp  0 \amp -3 \amp -1 \\
			0 \amp  0 \amp -4 \amp -6 \\
			0 \amp  0 \amp  0 \amp  3
		\end{abmatrix}
	</m></p></statement>
	<answer><p> Not invertible. </p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			 4 \amp 0 \amp 0 \amp 0 \\
			-4 \amp 2 \amp 0 \amp 0 \\
			 3 \amp 6 \amp 2 \amp 0 \\
			-3 \amp 2 \amp 6 \amp -4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			 \frac{ 1}{4} \amp       0      \amp      0      \amp       0      \\
			 \frac{ 1}{2} \amp  \frac{1}{2} \amp      0      \amp       0      \\
			-\frac{15}{8} \amp -\frac{3}{2} \amp \frac{1}{2} \amp       0      \\
			-\frac{11}{4} \amp      -2      \amp \frac{3}{4} \amp -\frac{1}{4}
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			 4 \amp 0 \amp 0 \amp 0 \\
			-4 \amp 2 \amp 0 \amp 0 \\
			 3 \amp 6 \amp 0 \amp 0 \\
			-3 \amp 2 \amp 6 \amp -4
		\end{abmatrix}
	</m></p></statement>
	<answer><p> Not invertible. </p></answer>
</exercise>

</exercisegroup>
