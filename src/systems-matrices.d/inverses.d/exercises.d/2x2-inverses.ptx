<exercisegroup cols="3" xml:id="exercisegroup-inverses-2x2">
<title>Computing <m>2 \times 2</m> inverses</title>

<introduction><p>
	Use the <xref ref="proposition-inverses-2x2-inverse" text="title" />
	(<xref ref="proposition-inverses-2x2-inverse" />),
	if possible,
	to compute the inverse of each matrix.
	In the case that the matrix is invertible,
	multiply it against your computed inverse to verify that your inverse is correct.
</p></introduction>

<exercise xml:id="exercise-inverses-2x2-1">
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rr}
			1 \amp -1 \\
			3 \amp -2
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rr}
			-2 \amp 1 \\
			-3 \amp 1
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise xml:id="exercise-inverses-2x2-2">
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rr}
			-5 \amp -9 \\
			 1 \amp 2
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rr}
			-2 \amp -9 \\
			 1 \amp  5
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			1 \amp 1 \\
			1 \amp 1
		\end{bmatrix}
	</m></p></statement>
	<answer><p> This matrix is <xref ref="definition-inverses-singular" text="custom">singular</xref>. </p></answer>
</exercise>

<exercise>
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			 7 \amp 2 \\
			21 \amp 6
		\end{bmatrix}
	</m></p></statement>
	<answer><p> This matrix is <xref ref="definition-inverses-singular" text="custom">singular</xref>. </p></answer>
</exercise>

<exercise xml:id="exercise-inverses-2x2-3">
	<statement><p><m>\displaystyle
		\begin{abmatrix}{rr}
			 2 \amp -3 \\
			-2 \amp  4
		\end{abmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{bmatrix}
			2 \amp \frac{3}{2} \\
			1 \amp      1
		\end{bmatrix}
	</m></p></answer>
</exercise>

<exercise xml:id="exercise-inverses-2x2-4">
	<statement><p><m>\displaystyle
		\begin{bmatrix}
			\frac{1}{3} \amp \frac{2}{3} \\
			     1      \amp      3
		\end{bmatrix}
	</m></p></statement>
	<answer><p><m>\displaystyle
		\begin{abmatrix}{rr}
			 9 \amp -2 \\
			-3 \amp  1
		\end{abmatrix}
	</m></p></answer>
</exercise>

</exercisegroup>
