<exercisegroup cols="2">
<title>Dimensions of matrix products</title>

<introduction><p>
	In each case,
	determine the dimensions of the product matrix <m>A B</m>,
	or state why the product matrix does not exist,
	based on the stated dimensions of the individual factor matrices <m>A</m> and <m>B</m>.
</p></introduction>

<exercise>
	<statement><p> <m>A \colon \ 1 \times 4</m>; <m>B \colon \ 4 \times 1</m>. </p></statement>
	<answer><p> <m>A B \colon \ 1 \times 1</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 4</m>; <m>B \colon \ 4 \times 1</m>. </p></statement>
	<answer><p> <m>A B \colon \ 3 \times 1</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 2 \times 3</m>; <m>B \colon \ 3 \times 4</m>. </p></statement>
	<answer><p> <m>A B \colon \ 2 \times 4</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 4</m>; <m>B \colon \ 2 \times 3</m>. </p></statement>
	<answer><p> <alert>Undefined.</alert> The number of columns in <m>A</m> does not match the number of rows in <m>B</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 3</m>; <m>B \colon \ 3 \times 3</m>. </p></statement>
	<answer><p> <m>A B \colon \ 3 \times 3</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 4</m>; <m>B \colon \ 3 \times 4</m>. </p></statement>
	<answer><p> <alert>Undefined.</alert> The number of columns in <m>A</m> does not match the number of rows in <m>B</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 4 \times 3</m>; <m>B \colon \ 4 \times 3</m>. </p></statement>
	<answer><p> <alert>Undefined.</alert> The number of columns in <m>A</m> does not match the number of rows in <m>B</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 4</m>; <m>B \colon \ 4 \times 3</m>. </p></statement>
	<answer><p> <m>A B \colon \ 3 \times 3</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 4 \times 3</m>; <m>B \colon \ 3 \times 4</m>. </p></statement>
	<answer><p> <m>A B \colon \ 4 \times 4</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 3</m>; <m>B \colon \ 3 \times 4</m>. </p></statement>
	<answer><p> <m>A B \colon \ 3 \times 4</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 3 \times 4</m>; <m>B \colon \ 4 \times 4</m>. </p></statement>
	<answer><p> <m>A B \colon \ 3 \times 4</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 1 \times 1</m>; <m>B \colon \ 2 \times 2</m>. </p></statement>
	<answer><p> <alert>Undefined.</alert> The number of columns in <m>A</m> does not match the number of rows in <m>B</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 1 \times 1</m>; <m>B \colon \ 1 \times 3</m>. </p></statement>
	<answer><p> <m>A B \colon \ 1 \times 3</m>. </p></answer>
</exercise>

<exercise>
	<statement><p> <m>A \colon \ 4 \times 1</m>; <m>B \colon \ 1 \times 3</m>. </p></statement>
	<answer><p> <m>A B \colon \ 4 \times 3</m>. </p></answer>
</exercise>

</exercisegroup>
