<exercisegroup cols="2" xml:id="exercisegroup-matrix-ops-entry-patterns">
<title>Matrix arithmetic entry patterns</title>

<introduction><p>
	For each matrix operation,
	write out the relationship between the entries of the <q>input</q> matrices and the entries of the resulting <q>output</q> matrix.
</p></introduction>

<exercise xml:id="exercise-matrix-ops-entry-patterns-add">
	<title>Addition</title>
	<p>
	For <m>C = A + B</m>,
	where <m>A</m> and <m>B</m> are both of size <m>m \times n</m>,
	express the general entry <m>c_{ij}</m> of the <m>m \times n</m> sum matrix <m>C</m> as a formula in the entries of <m>A</m> and <m>B</m>.
	</p>
</exercise>

<exercise xml:id="exercise-matrix-ops-entry-patterns-diff">
	<title>Subtraction</title>
	<p>
	For <m>C = A - B</m>,
	where <m>A</m> and <m>B</m> are both of size <m>m \times n</m>,
	express the general entry <m>c_{ij}</m> of the <m>m \times n</m> difference matrix <m>C</m> as a formula in the entries of <m>A</m> and <m>B</m>.
	</p>
</exercise>

<exercise xml:id="exercise-matrix-ops-entry-patterns-neg">
	<title>Negation</title>
	<p>
	For <m>C = -A</m>,
	where <m>A</m> is of size <m>m \times n</m>,
	express the general entry <m>c_{ij}</m> of the <m>m \times n</m> negative matrix <m>C</m> as a formula in the entries of <m>A</m>.
	</p>
</exercise>

<exercise xml:id="exercise-matrix-ops-entry-patterns-smul">
	<title>Scalar multiplication</title>
	<p>
	For <m>C = k A</m>,
	where <m>A</m> is of size <m>m \times n</m> and <m>k</m> is a scalar,
	express the general entry <m>c_{ij}</m> of the <m>m \times n</m> scaled matrix <m>C</m> as a formula in the entries of <m>A</m>.
	</p>
</exercise>

<exercise xml:id="exercise-matrix-ops-entry-patterns-trans">
	<title>Transpose</title>
	<p>
	For <m>C = \utrans{A}</m>,
	where <m>A</m> is of size <m>m \times n</m>,
	express the general entry <m>c_{ij}</m> of the <m>m \times n</m> transposed matrix <m>C</m> as a formula in the entries of <m>A</m>.
	</p>
</exercise>

<exercise xml:id="exercise-matrix-ops-entry-patterns-mult">
	<title>Multiplication</title>

	<statement><p>
		For <m>C = A B</m>,
		where <m>A</m> is an <m>\ell \times m</m> matrix and <m>B</m> is an <m>m \times n</m> matrix,
		express the general entry <m>c_{ij}</m> of the <m>\ell \times n</m> product matrix <m>C</m> as a formula in the entries of <m>A</m> and <m>B</m>.
	</p></statement>

	<hint><p>
		See <xref ref="equation-matrix-ops-concepts-row-times-column">Formula</xref>
		and <xref ref="equation-matrix-ops-concepts-matrix-mult-full">Formula</xref>
		from <xref ref="subsection-matrix-ops-concepts-matrix-mult" />.
	</p></hint>

</exercise>

<exercise xml:id="exercise-matrix-ops-entry-patterns-power">
	<title>Square</title>
	<p>
	For <m>C = A^2</m>,
	where <m>A</m> is of square size <m>n \times n</m>,
	express the general entry <m>c_{ij}</m> of the <m>n \times n</m> power matrix <m>C</m> as a formula in the entries of <m>A</m>.
	</p>
</exercise>

<!-- If adding more, search for last="exercise-matrix-ops-entry-patterns-.*" -->

</exercisegroup>
