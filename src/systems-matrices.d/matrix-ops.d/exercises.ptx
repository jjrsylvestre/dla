<exercises xml:id="exercises-matrix-ops" xmlns:xi="http://www.w3.org/2001/XInclude">
<title>Exercises</title>

<exercise>
	<title>Rows and columns</title>

	<introduction><p>
		Consider matrix
		<me>
			A = \begin{abmatrix}{rrrr}
				 8 \amp -4 \amp -9 \amp -9 \\
				-5 \amp  7 \amp  4 \amp  2 \\
				 6 \amp -8 \amp  1 \amp -5
			\end{abmatrix}
		</me>.
	</p></introduction>

	<task>
		<statement><p> Express each row of <m>A</m> as a <term><xref ref="definition-matrix-ops-row-vector" text="title" /></term>. </p></statement>
		<answer><p>
			The rows of <m>A</m> are:
			<md>
				<mrow> \text{Row 1: } \amp \begin{bmatrix}  8 \amp -4 \amp -9 \amp -9 \end{bmatrix} \text{,} </mrow>
				<mrow> \text{Row 2: } \amp \begin{bmatrix} -5 \amp  7 \amp  4 \amp  2 \end{bmatrix} \text{,} </mrow>
				<mrow> \text{Row 3: } \amp \begin{bmatrix}  6 \amp -8 \amp  1 \amp -5 \end{bmatrix} \text{.} </mrow>
			</md>
		</p></answer>
	</task>

	<task>
		<statement><p> Express each column of <m>A</m> as a <term><xref ref="definition-matrix-ops-column-vector" text="title" /></term>. </p></statement>
		<answer><p>
			The columns of <m>A</m> are
			<md>
				<mrow>
					\amp \text{Column 1:} \amp
					\amp \text{Column 2:} \amp
					\amp \text{Column 3:} \amp
					\amp \text{Column 4:}
				</mrow>
				<mrow>
					\amp \begin{abmatrix}{r}  8 \\ -5 \\  6 \end{abmatrix} \text{,} \amp
					\amp \begin{abmatrix}{r} -4 \\  7 \\ -8 \end{abmatrix} \text{,} \amp
					\amp \begin{abmatrix}{r} -9 \\  4 \\  1 \end{abmatrix} \text{,} \amp
					\amp \begin{abmatrix}{r} -9 \\  2 \\ -5 \end{abmatrix} \text{.}
				</mrow>
			</md>
		</p></answer>
	</task>

	<task>
		<statement><p> State the dimensions of <m>A</m>. </p></statement>
		<answer><p> There are three rows and four columns, so the dimensions of <m>A</m> are <m>3 \times 4</m>. </p></answer>
	</task>

</exercise>

<exercise>
	<title>Indexing matrix entries</title>

	<introduction><p>
		Consider matrix
		<me>
			A = \begin{abmatrix}{rrrr}
				-2 \amp -1 \amp  5 \\
				 9 \amp -8 \amp  7 \\
				 1 \amp  4 \amp -3 \\
				 3 \amp  6 \amp -5
			\end{abmatrix}
		</me>.
	</p></introduction>

	<task>
		<statement><p> Identify the value of each of the entries <m>a_{12}, a_{33}, a_{41}</m>.</p></statement>
		<answer><p> <m> a_{12} = -1 </m>, <m> a_{33} = -3 </m>, <m> a_{41} = 3 </m>. </p></answer>
	</task>

	<task>
		<statement><p> Identify the indices of each of the positive entries of <m>A</m>. </p></statement>
		<answer><p>
			The positive entries are
			<m> a_{13} = 5 </m>,
			<m> a_{21} = 9 </m>,
			<m> a_{23} = 7 </m>,
			<m> a_{31} = 1 </m>,
			<m> a_{32} = 4 </m>,
			<m> a_{41} = 3 </m>,
			<m> a_{42} = 6 </m>.
		</p></answer>
	</task>

</exercise>

<exercise xml:id="exercise-matrix-ops-dimensions">
	<title>Matrix dimensions</title>
	<statement><p>
		State the <term><xref ref="definition-matrix-ops-size" text="custom">dimensions</xref></term> of each of the matrices below.
		Which of these matrices is <term><xref ref="definition-matrix-ops-square-matrix" text="custom">square</xref></term>?
		<md alignment="gather"><mrow>
			\begin{abmatrix}{rrr}
				-5 \amp  6 \amp -8 \\
				-4 \amp -4 \amp  0 \\
				 7 \amp  1 \amp  2
			\end{abmatrix}
			\qquad
			\begin{abmatrix}{rrr}
				7 \amp  1 \amp -8 \\
				6 \amp  3 \amp  6 \\
				2 \amp  8 \amp -6 \\
				1 \amp -2 \amp -9 \\
				0 \amp  0 \amp  0
			\end{abmatrix}
			\qquad
			\begin{abmatrix}{rrrr}
				 0 \amp  8 \amp 1 \amp  0 \\
				-5 \amp -7 \amp 4 \amp  9 \\
				 1 \amp  4 \amp 9 \amp -2
			\end{abmatrix}
		</mrow><mrow /><mrow>
			\begin{abmatrix}{rrrr}
				 2 \amp  0 \amp  9 \amp -7 \\
				 4 \amp  9 \amp -1 \amp -7 \\
				-8 \amp -5 \amp -1 \amp -8 \\
				 5 \amp  9 \amp  3 \amp  7
			\end{abmatrix}
		</mrow></md>
	</p></statement>
	<answer><p>
		The dimensions (in order) are
		<m>3 \times 3</m>, <m>5 \times 3</m>, <m>3 \times 4</m>, and <m>4 \times 4</m>.
		Only the first and last matrices are square.
	</p></answer>
</exercise>

<exercise>
	<title>Identifying the main diagonal in a square matrix</title>

	<statement><p>
		For those matrices from <xref ref="exercise-matrix-ops-dimensions" text="type-local" /> that are square,
		identify the <term><xref ref="definition-matrix-ops-main-diagonal" text="title" /></term>.
	</p></statement>

	<answer>

		<p>
		The first matrix from <xref ref="exercise-matrix-ops-dimensions" text="type-local" />
		(call it <m>A</m>)
		is square,
		and has main diagonal <m>a_{11} = -5</m>, <m>a_{22} = -4</m>, and <m>a_{33} = 2</m>:
		<me>
			\begin{abmatrix}{rrr}
				{\color{red}\mathbf{-5}} \amp             6            \amp             -8           \\
				           -4            \amp {\color{red}\mathbf{-4}} \amp              0           \\
				            7            \amp             1            \amp  {\color{red}\mathbf{2}}
			\end{abmatrix}
		</me>.
		</p>

		<p>
		The last matrix from <xref ref="exercise-matrix-ops-dimensions" text="type-local" />
		(call it <m>D</m>)
		is square,
		and has main diagonal <m>d_{11} = 2</m>, <m>d_{22} = 9</m>, <m>d_{33} = -1</m>, and <m>d_{44} = 7</m>:
		<me>
			\begin{abmatrix}{rrrr}
				{\color{red}\mathbf{2}} \amp             0           \amp             9            \amp            -7           \\
				            4           \amp {\color{red}\mathbf{9}} \amp            -1            \amp            -7           \\
				           -8           \amp            -5           \amp {\color{red}\mathbf{-1}} \amp            -8           \\
				            5           \amp             9           \amp             3            \amp {\color{red}\mathbf{7}}
			\end{abmatrix}
		</me>.
		</p>

	</answer>

</exercise>

<exercse>
	<title>Patterns of entry indices in square matrices</title>

	<task><p>
		What common pattern do the <xref ref="definition-matrix-ops-index-pair" text="custom">index pairs</xref> for entries along the main diagonal in a square matrix exhibit?
	</p></task>

	<task><p>
		What common pattern do the <xref ref="definition-matrix-ops-index-pair" text="custom">index pairs</xref> for entries <em>above</em> the main diagonal in a square matrix exhibit?
	</p></task>

	<task><p>
		What common pattern do the <xref ref="definition-matrix-ops-index-pair" text="custom">index pairs</xref> for entries <em>below</em> the main diagonal in a square matrix exhibit?
	</p></task>

</exercse>

<exercise>
	<title>Matrix entries as a function of row and column indices</title>
	<statement><p> Form the <m>4 \times 4</m> matrix <m>A</m> whose entries satisfy the formula <m>a_{ij} = i^2 - j^2</m>. </p></statement>
	<answer><p><m>\displaystyle
		A = \begin{abmatrix}{rrrr}
			 0 \amp -3 \amp -8 \amp -15 \\
			 3 \amp  0 \amp -5 \amp -12 \\
			 8 \amp  5 \amp  0 \amp - 7 \\
			15 \amp 12 \amp  7 \amp   0
		\end{abmatrix}
	</m></p></answer>
</exercise>

<exercise>
	<title>Restricting matrix entries based on indices</title>
	<statement><p>
		As usual, let <m>i</m> represent the row index and <m>j</m> represent the column index of each entry in a matrix.
		Create a <m>6 \times 6</m> matrix has the following properties:
		<ul>
			<li>
				All entries with <m>i \gt j</m> are zero,
				all other entries are nonzero.
			</li>
			<li> Each nonzero entry is positive if <m>i + j</m> is even and negative if <m>i + j</m> is odd. </li>
			<li> No two nonzero entries have the same absolute value. </li>
		</ul>
	</p></statement>
	<answer><p>
		Here is one possible matrix that satisfies the stated restrictions:
		<me>
			\begin{abmatrix}{rrrrrr}
				1 \amp -2 \amp  3 \amp - 4 \amp   5 \amp - 6 \\
				0 \amp  7 \amp -8 \amp   9 \amp -10 \amp  11 \\
				0 \amp  0 \amp 12 \amp -13 \amp  14 \amp -15 \\
				0 \amp  0 \amp  0 \amp  16 \amp -17 \amp  18 \\
				0 \amp  0 \amp  0 \amp   0 \amp  19 \amp -20 \\
				0 \amp  0 \amp  0 \amp   0 \amp   0 \amp  21
			\end{abmatrix}
		</me>.
	</p></answer>
</exercise>

<exercise>
	<title>Matrix inequality</title>

	<introduction><p>
		For each example matrix <m>X</m> below,
		give at least one reason why <m>X</m> is not equal to matrix
		<me>
			A = \begin{abmatrix}{rrr}
				1 \amp  1 \amp  8 \\
				0 \amp -1 \amp -7
			\end{abmatrix}
		</me>.
	</p></introduction>

	<task>
		<statement><p><m>\displaystyle
			X = \begin{abmatrix}{rrrr}
				1 \amp  1 \amp  8 \amp 0 \\
				0 \amp -1 \amp -7 \amp 0
			\end{abmatrix}
		</m></p></statement>
		<answer><p> Matrix <m>X</m> is not equal to matrix <m>A</m> because <m>X</m> has a fourth column that <m>A</m> lacks. </p>
		</answer>
	</task>

	<task>
		<statement><p><m>\displaystyle
			X = \begin{abmatrix}{rrr}
				1 \amp  1 \amp  8 \\
				0 \amp -1 \amp -7 \\
				0 \amp  0 \amp  0
			\end{abmatrix}
		</m></p></statement>
		<answer><p> Matrix <m>X</m> is not equal to matrix <m>A</m> because <m>X</m> has a third row that <m>A</m> lacks. </p>
		</answer>
	</task>

	<task>
		<statement><p><m>\displaystyle
			X = \begin{abmatrix}{rrr}
				1 \amp  1 \amp  8 \\
				0 \amp  1 \amp -7
			\end{abmatrix}
		</m></p></statement>
		<answer><p> Matrix <m>X</m> is not equal to matrix <m>A</m> because <m>x_{21} = 1</m> while <m>a_{21} = -1</m>. </p>
		</answer>
	</task>

</exercise>

