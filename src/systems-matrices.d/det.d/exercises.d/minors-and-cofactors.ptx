<exercisegroup cols="2" xml:id="exercisegroup-det-minors-and-cofactors">
<title>Minors and cofactors</title>

<introduction><p>
	In each case,
	calculate the requested minors and cofactors of the given matrix.
	For the larger matrices
	in <xref ref="exercise-det-minors-and-cofactors-4x4-1" text="type-local" />
	and <xref ref="exercise-det-minors-and-cofactors-4x4-2" text="type-local" />,
	express the requested minors as unevaluated determinant matrices
	and cofactors in terms of the minor.
</p></introduction>


<!-- 2 x 2 -->

<exercise>

	<introduction><p><m>\displaystyle
		\begin{abmatrix}{rr}
			-2 \amp 1 \\
			 0 \amp 4
		\end{abmatrix}
	</m></p></introduction>

	<task>
		<statement><p><m>M_{11}</m></p></statement>
		<answer><p><m>M_{11} = 4</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{11}</m></p></statement>
		<answer><p><m>C_{11} = M_{11} = 4</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{21}</m></p></statement>
		<answer><p><m>M_{21} = 1</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{21}</m></p></statement>
		<answer><p><m>C_{21} = -M_{21} = -1</m></p></answer>
	</task>

</exercise>

<exercise>

	<introduction><p><m>\displaystyle
		\begin{abmatrix}{rr}
			3 \amp -6 \\
			8 \amp  7
		\end{abmatrix}
	</m></p></introduction>

	<task>
		<statement><p><m>M_{12}</m></p></statement>
		<answer><p><m>M_{12} = 8</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{12}</m></p></statement>
		<answer><p><m>C_{12} = -M_{12} = -8</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{22}</m></p></statement>
		<answer><p><m>M_{22} = 3</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{22}</m></p></statement>
		<answer><p><m>C_{22} = M_{22} = 3</m></p></answer>
	</task>

</exercise>

<!-- 3 x 3 -->

<exercise>

	<introduction><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			 0 \amp  5 \amp -3 \\
			-2 \amp  2 \amp -6 \\
			 1 \amp -1 \amp  2
		\end{abmatrix}
	</m></p></introduction>

	<task>
		<statement><p><m>M_{11}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{11} =
			\begin{avmatrix}{rr}
				 2 \amp -6 \\
				-1 \amp  2
			\end{avmatrix}
			= -2
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{11}</m></p></statement>
		<answer><p><m>C_{11} = M_{11} = -2</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{13}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{13} =
			\begin{avmatrix}{rr}
				-2 \amp  2 \\
				 1 \amp -1
			\end{avmatrix}
			= 0
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{13}</m></p></statement>
		<answer><p><m>C_{13} = M_{13} = 0</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{31}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{31} =
			\begin{avmatrix}{rr}
				5 \amp -3 \\
				2 \amp -6
			\end{avmatrix}
			= -24
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{31}</m></p></statement>
		<answer><p><m>C_{31} = M_{31} = -24</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{33}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{33} =
			\begin{avmatrix}{rr}
				 0 \amp  5 \\
				-2 \amp  2
			\end{avmatrix}
			= 10
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{33}</m></p></statement>
		<answer><p><m>C_{33} = M_{33} = 10</m></p></answer>
	</task>

</exercise>

<exercise>

	<introduction><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-2 \amp  2 \amp -1 \\
			 3 \amp -3 \amp -4 \\
			-2 \amp -3 \amp -2
		\end{abmatrix}
	</m></p></introduction>

	<task>
		<statement><p><m>M_{12}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{12} =
			\begin{avmatrix}{rr}
				 3 \amp -4 \\
				-2 \amp -2
			\end{avmatrix}
			= -14
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{12}</m></p></statement>
		<answer><p><m>C_{12} = -M_{12} = 14</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{21}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{21} =
			\begin{avmatrix}{rr}
				 2 \amp -1 \\
				-3 \amp -2
			\end{avmatrix}
			= -7
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{21}</m></p></statement>
		<answer><p><m>C_{21} = -M_{21} = 7</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{23}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{23} =
			\begin{avmatrix}{rr}
				-2 \amp  2 \\
				-2 \amp -3
			\end{avmatrix}
			= 10
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{23}</m></p></statement>
		<answer><p><m>C_{23} = -M_{23} = -10</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{32}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{32} =
			\begin{avmatrix}{rr}
				-2 \amp -1 \\
				 3 \amp -4
			\end{avmatrix}
			= 11
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{32}</m></p></statement>
		<answer><p><m>C_{32} = -M_{32} = -11</m></p></answer>
	</task>

</exercise>

<!-- 4 x 4 -->

<exercise xml:id="exercise-det-minors-and-cofactors-4x4-1">

	<introduction><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			 4 \amp -3 \amp  5 \amp 6 \\
			-1 \amp -6 \amp  2 \amp 2 \\
			 3 \amp  0 \amp  0 \amp 5 \\
			 4 \amp  6 \amp -3 \amp 0
		\end{abmatrix}
	</m></p></introduction>

	<task>
		<statement><p><m>M_{22}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{22} =
			\begin{avmatrix}{rrr}
				 4 \amp  5 \amp 6 \\
				 3 \amp  0 \amp 5 \\
				 4 \amp -3 \amp 0
			\end{avmatrix}
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{22}</m></p></statement>
		<answer><p><m>C_{22} = M_{22}</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{32}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{32} =
			\begin{avmatrix}{rrr}
				 4 \amp  5 \amp 6 \\
				-1 \amp  2 \amp 2 \\
				 4 \amp -3 \amp 0
			\end{avmatrix}
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{32}</m></p></statement>
		<answer><p><m>C_{32} = -M_{32}</m></p></answer>
	</task>

</exercise>

<exercise xml:id="exercise-det-minors-and-cofactors-4x4-2">

	<introduction><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			 0 \amp  6 \amp  0 \amp 5 \\
			-4 \amp  5 \amp  4 \amp 1 \\
			 2 \amp -5 \amp  3 \amp 4 \\
			-2 \amp  6 \amp -4 \amp 3
		\end{abmatrix}
	</m></p></introduction>

	<task>
		<statement><p><m>M_{43}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{43} =
			\begin{avmatrix}{rrr}
				 0 \amp  6 \amp 5 \\
				-4 \amp  5 \amp 1 \\
				 2 \amp -5 \amp 4 \\
			\end{avmatrix}
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{43}</m></p></statement>
		<answer><p><m>C_{43} = -M_{43}</m></p></answer>
	</task>

	<task>
		<statement><p><m>M_{13}</m></p></statement>
		<answer><p><m>\displaystyle
			M_{13} =
			\begin{avmatrix}{rrr}
				-4 \amp  5 \amp 1 \\
				 2 \amp -5 \amp 4 \\
				-2 \amp  6 \amp 3
			\end{avmatrix}
		</m></p></answer>
	</task>

	<task>
		<statement><p><m>C_{13}</m></p></statement>
		<answer><p><m>C_{13} = M_{13}</m></p></answer>
	</task>

</exercise>

</exercisegroup>
