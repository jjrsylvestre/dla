<exercisegroup cols="2">
<title>Creating elementary matrices</title>

<introduction><p>
	In each case,
	create an <xref ref="definition-elem-matrices" text="title" />
	of the stated size that represents the specified operation.
	Then also create its inverse.
</p></introduction>

<exercise>
	<statement><p> <m> 2 \times 2 </m>; swap rows </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix} 0 \amp 1 \\ 1 \amp 0 \end{bmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \text{same.}                                                </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 2 \times 2 </m>; multiply first row by <m>-3</m> </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{abmatrix}{rr}      -3      \amp 0 \\ 0 \amp 1 \end{abmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{abmatrix}{rr} -\frac{1}{3} \amp 0 \\ 0 \amp 1 \end{abmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 2 \times 2 </m>; multiply second row by <m>\pi</m> </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix} 1 \amp 0 \\ 0 \amp  \pi  \end{bmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{bmatrix} 1 \amp 0 \\ 0 \amp 1/\pi \end{bmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 2 \times 2 </m>; add <m>4</m> times the first row to the second </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix}      1 \amp 0 \\  4 \amp 1 \end{bmatrix}  \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{abmatrix}{rr} 1 \amp 0 \\ -4 \amp 1 \end{abmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 2 \times 2 </m>; subtract <m>3/2</m> times the second row from the first </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{abmatrix}{rr} 1 \amp -\frac{3}{2} \\ 0 \amp 1 \end{abmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{abmatrix}{rr} 1 \amp  \frac{3}{2} \\ 0 \amp 1 \end{abmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 3 \times 3 </m>; swap first and third rows </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix} 0 \amp 0 \amp 1 \\ 0 \amp 1 \amp 0 \\ 1 \amp 0 \amp 0 \end{bmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \text{same.}                                                                                 </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 3 \times 3 </m>; swap second and third rows </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix} 1 \amp 0 \amp 0 \\ 0 \amp 0 \amp 1 \\ 0 \amp 1 \amp 0 \end{bmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \text{same.}                                                                                 </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 3 \times 3 </m>; multiply second row by <m>5/4</m> </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix} 1 \amp 0 \amp 0 \\ 0 \amp \frac{5}{4} \amp 0 \\ 0 \amp 0 \amp 1 \end{bmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{bmatrix} 1 \amp 0 \amp 0 \\ 0 \amp \frac{4}{5} \amp 0 \\ 0 \amp 0 \amp 1 \end{bmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 3 \times 3 </m>; add <m>4</m> times the first row to the second </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix}       1 \amp 0 \amp 0 \\  4 \amp 1 \amp 0 \\ 0 \amp 0 \amp 1 \end{bmatrix}  \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{abmatrix}{rrr} 1 \amp 0 \amp 0 \\ -4 \amp 1 \amp 0 \\ 0 \amp 0 \amp 1 \end{abmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 3 \times 3 </m>; subtract <m>\sqrt{2}</m> times the third row from the first </p></statement>
	<answer><p><md>
		<mrow>    E    \amp = \begin{bmatrix} 1 \amp 0 \amp -\sqrt{2} \\ 0 \amp 1 \amp 0 \\ 0 \amp 0 \amp 1 \end{bmatrix} \text{,} </mrow>
		<mrow> \inv{E} \amp = \begin{bmatrix} 1 \amp 0 \amp  \sqrt{2} \\ 0 \amp 1 \amp 0 \\ 0 \amp 0 \amp 1 \end{bmatrix} \text{.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 4 \times 4 </m>; swap third and fourth rows </p></statement>
	<answer><p><md>
		<mrow>
			E \amp =
			\begin{bmatrix}
				1 \amp 0 \amp 0 \amp 0 \\
				0 \amp 1 \amp 0 \amp 0 \\
				0 \amp 0 \amp 0 \amp 1 \\
				0 \amp 0 \amp 1 \amp 0
			\end{bmatrix}
			\text{,}
		</mrow>
		<mrow> \inv{E} \amp = \text{same.} </mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 4 \times 4 </m>; multiply third row by <m>1/7</m> </p></statement>
	<answer><p><md>
		<mrow>
			E \amp =
			\begin{bmatrix}
				1 \amp 0 \amp      0      \amp 0 \\
				0 \amp 1 \amp      0      \amp 0 \\
				0 \amp 0 \amp \frac{1}{7} \amp 0 \\
				0 \amp 0 \amp      0      \amp 1
			\end{bmatrix}
			\text{,}
		</mrow>
		<mrow>
			\inv{E} \amp =
			\begin{bmatrix}
				1 \amp 0 \amp 0 \amp 0 \\
				0 \amp 1 \amp 0 \amp 0 \\
				0 \amp 0 \amp 7 \amp 0 \\
				0 \amp 0 \amp 0 \amp 1
			\end{bmatrix}
			\text{.}
		</mrow>
	</md></p></answer>
</exercise>

<exercise>
	<statement><p> <m> 4 \times 4 </m>; add <m>2</m> times the first row to the fourth </p></statement>
	<answer><p><md>
		<mrow>
			E \amp =
			\begin{bmatrix}
				1 \amp 0 \amp 0 \amp 0 \\
				0 \amp 1 \amp 0 \amp 0 \\
				0 \amp 0 \amp 1 \amp 0 \\
				2 \amp 0 \amp 0 \amp 1
			\end{bmatrix}
			\text{,}
		</mrow>
		<mrow>
			\inv{E} \amp =
			\begin{bmatrix}
				     1      \amp 0 \amp 0 \amp 0 \\
				     0      \amp 1 \amp 0 \amp 0 \\
				     0      \amp 0 \amp 1 \amp 0 \\
				\frac{1}{2} \amp 0 \amp 0 \amp 1
			\end{bmatrix}
			\text{.}
		</mrow>
	</md></p></answer>
</exercise>

</exercisegroup>
