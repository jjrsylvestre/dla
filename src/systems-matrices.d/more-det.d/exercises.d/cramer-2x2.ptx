<exercisegroup cols="2">
<title>Cramer's rule for <m>2</m>-variable systems</title>

<introduction><p>
	Use <xref ref="theorem-more-det-cramers-rule" text="title" />
	(<xref ref="theorem-more-det-cramers-rule" />)
	to solve each system.
</p></introduction>

<exercise>

	<statement><p>
		<me>
			\begin{sysofeqns}{rcrcr}
				5 x \amp - \amp 12 y \amp = \amp 1 \\
				2 x \amp - \amp  5 y \amp = \amp 1
			\end{sysofeqns}
		</me>.
	</p></statement>

	<solution><p>
		Set
		<md><mrow>
			A \amp =
			\begin{abmatrix}{rr}
				5 \amp -12 \\
				2 \amp - 5
			\end{abmatrix}
			\text{,}
			\amp
			\uvec{b} \amp =
			\begin{bmatrix} 1 \\ 1 \end{bmatrix}
			\text{.}
		</mrow></md>
		Compute <m>\det A = -1</m>.
		Since <m>\det A \neq 0</m>,
		Cramer's rule can be applied.
		Replace one column of <m>A</m> by <m>\uvec{b}</m> and a time and compute determinants.
		<md>

			<mrow>
				A_x \amp =
				\begin{abmatrix}{rr}
					1 \amp -12 \\
					1 \amp - 5
				\end{abmatrix}
				\amp
				\det A_x \amp = 7
			</mrow>

			<mrow>
				A_y \amp =
				\begin{bmatrix}
					5 \amp 1 \\
					2 \amp 1
				\end{bmatrix}
				\amp
				\det A_y \amp = 3
			</mrow>

		</md>
		Finally, apply Cramer's rule:
		<md>

			<mrow>
				x \amp = \frac{\det A_x}{\det A} \amp
				y \amp = \frac{\det A_y}{\det A}
			</mrow>

			<mrow>
				\amp = \frac{7}{-1} \amp
				\amp = \frac{3}{-1}
			</mrow>

			<mrow>
				\amp = - 7 \text{,} \amp
				\amp = - 3 \text{.}
			</mrow>

		</md>
	</p></solution>

</exercise>

<exercise>

	<statement><p>
		<me>
			\begin{sysofeqns}{rcrcr}
				8 x \amp + \amp 7 y \amp = \amp 3 \\
				7 x \amp + \amp 7 y \amp = \amp 1
			\end{sysofeqns}
		</me>.
	</p></statement>

	<solution><p>
		Set
		<md><mrow>
			A \amp =
			\begin{bmatrix}
				8 \amp 7 \\
				7 \amp 7
			\end{bmatrix}
			\text{,}
			\amp
			\uvec{b} \amp =
			\begin{bmatrix} 3 \\ 1 \end{bmatrix}
			\text{.}
		</mrow></md>
		Compute <m>\det A = 7</m>.
		Since <m>\det A \neq 0</m>,
		Cramer's rule can be applied.
		Replace one column of <m>A</m> by <m>\uvec{b}</m> and a time and compute determinants.
		<md>

			<mrow>
				A_x \amp =
				\begin{bmatrix}
					3 \amp 7 \\
					1 \amp 7
				\end{bmatrix}
				\amp
				\det A_x \amp = 14
			</mrow>

			<mrow>
				A_y \amp =
				\begin{bmatrix}
					8 \amp 3 \\
					7 \amp 1
				\end{bmatrix}
				\amp
				\det A_y \amp = -13
			</mrow>

		</md>
		Finally, apply Cramer's rule:
		<md>

			<mrow>
				x \amp = \frac{\det A_x}{\det A} \amp
				y \amp = \frac{\det A_y}{\det A}
			</mrow>

			<mrow>
				\amp = \frac{14}{7} \amp
				\amp = - \frac{13}{7} \text{.}
			</mrow>

			<mrow>
				\amp = 2 \text{,}
			</mrow>

		</md>
	</p></solution>

</exercise>

<exercise>

	<statement><p>
		<me>
			\begin{sysofeqns}{rcrcr}
				6 s \amp + \amp 6 t \amp = \amp  5 \\
				7 s \amp + \amp 8 t \amp = \amp -8
			\end{sysofeqns}
		</me>.
	</p></statement>

	<solution><p>
		Set
		<md><mrow>
			A \amp =
			\begin{bmatrix}
				6 \amp 6 \\
				7 \amp 8
			\end{bmatrix}
			\text{,}
			\amp
			\uvec{b} \amp =
			\begin{abmatrix}{r} 5 \\ -8 \end{abmatrix}
			\text{.}
		</mrow></md>
		Compute <m>\det A = 6</m>.
		Since <m>\det A \neq 0</m>,
		Cramer's rule can be applied.
		Replace one column of <m>A</m> by <m>\uvec{b}</m> and a time and compute determinants.
		<md>

			<mrow>
				A_s \amp =
				\begin{abmatrix}{rr}
					 5 \amp 6 \\
					-8 \amp 8
				\end{abmatrix}
				\amp
				\det A_s \amp = 88
			</mrow>

			<mrow>
				A_t \amp =
				\begin{abmatrix}{rr}
					6 \amp  5 \\
					7 \amp -8
				\end{abmatrix}
				\amp
				\det A_t \amp = -83
			</mrow>

		</md>
		Finally, apply Cramer's rule:
		<md>

			<mrow>
				s \amp = \frac{\det A_s}{\det A} \amp
				t \amp = \frac{\det A_t}{\det A}
			</mrow>

			<mrow>
				\amp = \frac{88}{6} \amp
				\amp = - \frac{83}{6} \text{.}
			</mrow>

			<mrow> \amp = \frac{44}{3} \text{,} </mrow>

		</md>
	</p></solution>

</exercise>

<exercise>

	<statement><p>
		<me>
			\begin{sysofeqns}{rcrcr}
				6 \alpha \amp - \amp 9 \beta \amp = \amp -6 \\
				8 \alpha \amp + \amp 7 \beta \amp = \amp -4
			\end{sysofeqns}
		</me>.
	</p></statement>

	<solution><p>
		Set
		<md><mrow>
			A \amp =
			\begin{abmatrix}{rrr}
				6 \amp -9 \\
				8 \amp  7
			\end{abmatrix}
			\text{,}
			\amp
			\uvec{b} \amp =
			\begin{abmatrix}{r} -6 \\ -4 \end{abmatrix}
			\text{.}
		</mrow></md>
		Compute <m>\det A = 114</m>.
		Since <m>\det A \neq 0</m>,
		Cramer's rule can be applied.
		Replace one column of <m>A</m> by <m>\uvec{b}</m> and a time and compute determinants.
		<md>

			<mrow>
				A_{\alpha} \amp =
				\begin{abmatrix}{rr}
					-6 \amp -9 \\
					-4 \amp  7
				\end{abmatrix}
				\amp
				\det A_{\alpha} \amp = -78
			</mrow>

			<mrow>
				A_{\beta} \amp =
				\begin{abmatrix}{rrr}
					6 \amp -6 \\
					8 \amp -4
				\end{abmatrix}
				\amp
				\det A_{\beta} \amp = 24
			</mrow>

		</md>
		Finally, apply Cramer's rule:
		<md>

			<mrow>
				\alpha \amp = \frac{\det A_{\alpha}}{\det A} \amp
				\beta \amp = \frac{\det A_{\beta}}{\det A}
			</mrow>

			<mrow>
				\amp = - \frac{78}{114} \amp
				\amp = \frac{24}{114}
			</mrow>

			<mrow>
				\amp = - \frac{13}{19} \text{,} \amp
				\amp = \frac{4}{19} \text{.}
			</mrow>

		</md>
	</p></solution>

</exercise>

</exercisegroup>
