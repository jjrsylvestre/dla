<exercisegroup cols="2">
<title>Algebra of the determinant</title>

<introduction><p>
	Let <m>A, B, C</m> represent square matrices of the same size where it is known that
	<md><mrow>
		\det A \amp = -3 \text{,} \amp
		\det B \amp = -1 \text{,} \amp
		\det C \amp =  4 \text{.}
	</mrow></md>
	Use this information to compute the following.
</p></introduction>

<exercise>
	<statement><p><m>\det (A B)</m></p></statement>
	<answer><p><m>3</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (A C)</m></p></statement>
	<answer><p><m>-12</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (C A)</m></p></statement>
	<answer><p><m>-12</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (A B C)</m></p></statement>
	<answer><p><m>12</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (\inv{C} A^2)</m></p></statement>
	<answer><p><m>9 / 4</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (A \inv{C} A)</m></p></statement>
	<answer><p><m>9 / 4</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (B^2 A B^3 \inv{A})</m></p></statement>
	<answer><p><m>-1</m></p></answer>
</exercise>

<exercise>
	<statement><p><m>\det (\inv{A} C \utrans{C} \inv{C} B)</m></p></statement>
	<answer><p><m>12</m></p></answer>
</exercise>


</exercisegroup>
