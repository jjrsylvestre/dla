<exercisegroup cols="2">
<title>Determinants of inverses</title>

<introduction><p>
	For each matrix:
	<ol>
		<li> Compute its determinant. </li>
		<li>
			Compute its inverse and the determinant of the result.
			(You may wish to use <xref ref="procedure-det-by-row-red" /> for the larger matrices.)
		</li>
		<li> Verify that the determinant of the inverse is the reciprocal of the determinant. </li>
	</ol>
</p></introduction>

<exercise>

	<statement><p><m>\displaystyle
		A =
		\begin{abmatrix}{rr}
			1 \amp  2 \\
			6 \amp -9
		\end{abmatrix}
	</m></p></statement>

	<answer><p><ol>

		<li> <m>\det A = -21</m> </li>

		<li>

			<p><m>\displaystyle
				\inv{A} =
				\begin{abmatrix}{rr}
					- \frac{1}{21} \amp - \frac{2}{21} \\
					- \frac{6}{21} \amp   \frac{9}{21}
				\end{abmatrix}
			</m></p>

			<p> <m> \det (\inv{A}) = - 1 / 21 </m> </p>

		</li>

		<li><m> \det (\inv{A}) = 1 / (-21) = 1 / (\det A) </m></li>

	</ol></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		A =
		\begin{abmatrix}{rrr}
			 1 \amp  0 \amp  0 \\
			-2 \amp  2 \amp  0 \\
			-1 \amp -2 \amp -2
		\end{abmatrix}
	</m></p></statement>

	<answer><p><ol>

		<li> <m>\det A = -4</m> </li>

		<li>

			<p><m>\displaystyle
				\inv{A} =
				\begin{abmatrix}{rrr}
					      1       \amp       0       \amp       0       \\
					      1       \amp   \frac{1}{2} \amp       0       \\
					- \frac{3}{2} \amp - \frac{1}{2} \amp - \frac{1}{2}
				\end{abmatrix}
			</m></p>

			<p> <m> \det (\inv{A}) = - 1 / 4 </m> </p>

		</li>

		<li><m> \det (\inv{A}) = 1 / (-4) = 1 / (\det A) </m></li>

	</ol></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		A =
		\begin{abmatrix}{rrrr}
			1 \amp  1 \amp -2 \amp  0 \\
			0 \amp  1 \amp -1 \amp -2 \\
			0 \amp -1 \amp  0 \amp -2 \\
			1 \amp  2 \amp -2 \amp  0
		\end{abmatrix}
	</m></p></statement>

	<answer><p><ol>

		<li> <m>\det A = 2</m> </li>

		<li>

			<p><m>\displaystyle
				\inv{A} =
				\begin{abmatrix}{rrrr}
					   -2       \amp -2 \amp       2       \amp       3       \\
					   -1       \amp  0 \amp       0       \amp       1       \\
					   -2       \amp -1 \amp       1       \amp       2       \\
					\frac{1}{2} \amp  0 \amp - \frac{1}{2} \amp - \frac{1}{2}
				\end{abmatrix}
			</m></p>

			<p> <m> \det (\inv{A}) = 1 / 2 </m> </p>

		</li>

		<li><m> \det (\inv{A}) = 1 / 2 = 1 / (\det A) </m></li>

	</ol></p></answer>

</exercise>

</exercisegroup>
