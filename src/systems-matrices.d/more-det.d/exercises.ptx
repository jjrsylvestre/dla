<exercises xml:id="exercises-more-det" xmlns:xi="http://www.w3.org/2001/XInclude">
<title>Exercises</title>

<!-- Exercise group -->
<xi:include href="./exercises.d/cofactors-and-adjoints.ptx" />

<exercise>
	<title>Adjoints of special matrices</title>
	<introduction><p> For each statement, construct a convincing argument that it is true. </p></introduction>
	<task><p> The adjoint of a diagonal matrix is always diagonal. </p></task>
	<task><p> The adjoint of an upper triangular matrix is always upper triangular. </p></task>
	<task><p> The adjoint of an lower triangular matrix is always lower triangular. </p></task>
	<task><p> The adjoint of a symmetric matrix is always symmetric. </p></task>
</exercise>

