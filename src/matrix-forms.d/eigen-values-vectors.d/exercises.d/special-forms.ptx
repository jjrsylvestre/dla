<exercisegroup cols="3" xml:id="exercisegroup-eigen-values-vectors-special-forms">
<title>Eigenvalues of special forms</title>

<introduction><p> Determine the eigenvalues of each matrix by inspection. </p></introduction>

<!-- 2×2 lower/diag/upper -->
<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rr}
			 6 \amp 0 \\
			-4 \amp 2
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = 6, 2</m></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rr}
			-5 \amp  0 \\
			 0 \amp -4
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = -5, -4</m></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rr}
			4 \amp -2 \\
			0 \amp -7
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = 4, -7</m></p></answer>

</exercise>

<!-- 3×3 lower/upper/diag -->
<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-5 \amp 0 \amp 0 \\
			-6 \amp 7 \amp 0 \\
			 7 \amp 1 \amp 4
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = -5, 7, 4</m></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			4 \amp 3 \amp -3 \\
			0 \amp 7 \amp  2 \\
			0 \amp 0 \amp  1
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = 4, 7, 1</m></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrr}
			-3 \amp 0 \amp  0 \\
			 0 \amp 6 \amp  0 \\
			 0 \amp 0 \amp -3
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = -3, 6</m></p></answer>

</exercise>

<!-- 4×4 upper/diag/lower -->
<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			1 \amp -5 \amp 6 \amp  8 \\
			0 \amp -8 \amp 8 \amp  0 \\
			0 \amp  0 \amp 9 \amp  0 \\
			0 \amp  0 \amp 0 \amp -2
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = 1, -8, 9, -2</m></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			3 \amp 0 \amp 0 \amp  0 \\
			0 \amp 4 \amp 0 \amp  0 \\
			0 \amp 0 \amp 0 \amp  0 \\
			0 \amp 0 \amp 0 \amp -7
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = 3, 4, 0, -7</m></p></answer>

</exercise>

<exercise>

	<statement><p><m>\displaystyle
		\begin{abmatrix}{rrrr}
			-9 \amp  0 \amp  0 \amp 0 \\
			 4 \amp -3 \amp  0 \amp 0 \\
			-3 \amp -6 \amp -3 \amp 0 \\
			-1 \amp  6 \amp -2 \amp 4
		\end{abmatrix}
	</m></p></statement>

	<answer><p><m>\lambda = 9, -3, 4</m></p></answer>

</exercise>

</exercisegroup>
