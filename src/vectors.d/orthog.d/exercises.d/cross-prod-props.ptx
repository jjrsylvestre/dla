<exercisegroup xml:id="exercisegroup-orthog-cross-prod-props">
<title>Properties the cross product</title>

<introduction>

	<p>
	For each property of the cross product from <xref ref="proposition-orthog-cross-prod-algebra" />,
	use <xref ref="equation-orthog-concepts-cross-prod-det-formula" />
	(and/or <xref ref="equation-orthog-concepts-expanded-cross-prod-det-formula" />)
	from <xref ref="subsection-orthog-concepts-cross-prod" />
	to verify it is true for all vectors <m> \uvec{u}, \uvec{v}, \uvec{w} </m> in <m> \R^3 </m> and all scalars <m> k </m>.
	</p>

	<p>
	<alert>Note.</alert>
	Be sure to use proper <em>left-hand side versus right-hand side</em> procedure for verifying an equality!
	</p>

</introduction>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-orthog-left" text="type-local">Rule</xref></title>
	<p><m> \dotprod{\uvec{u}}{(\ucrossprod{u}{v})} = 0 </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-orthog-right" text="type-local">Rule</xref></title>
	<p><m> \dotprod{\uvec{v}}{(\ucrossprod{u}{v})} = 0 </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-with-zero-right" text="type-local">Rule</xref></title>
	<p><m> \crossprod{\uvec{u}}{\zerovec} = \zerovec </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-with-zero-left" text="type-local">Rule</xref></title>
	<p><m> \crossprod{\zerovec}{\uvec{v}} = \zerovec </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-right-hand-rule" text="type-local">Rule</xref></title>
	<p><m> \ucrossprod{v}{u} = - \ucrossprod{u}{v} </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-scale-left" text="type-local">Rule</xref></title>
	<p><m> \crossprod{(k \uvec{u})}{\uvec{v}} = k (\ucrossprod{u}{v}) </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-scale-right" text="type-local">Rule</xref></title>
	<p><m> \crossprod{\uvec{u}}{(k \uvec{v})} = k (\ucrossprod{u}{v}) </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-add-left" text="type-local">Rule</xref></title>
	<p><m> \crossprod{(\uvec{u} + \uvec{v})}{\uvec{w}} = \ucrossprod{u}{w} + \ucrossprod{v}{w} </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-add-right" text="type-local">Rule</xref></title>
	<p><m> \crossprod{\uvec{u}}{(\uvec{v} + \uvec{w})} = \ucrossprod{u}{v} + \ucrossprod{u}{w} </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-with-self" text="type-local">Rule</xref></title>
	<p><m> \ucrossprod{u}{u} = \zerovec </m>.</p>
</exercise>

<exercise>
	<title><xref ref="proposition-orthog-cross-prod-algebra-with-parallel" text="type-local">Rule</xref></title>
	<p>
	If <m> \uvec{u} </m> and <m> \uvec{v} </m> are parallel,
	then <m> \ucrossprod{u}{v} = \zerovec </m>.
	</p>
</exercise>

</exercisegroup>
