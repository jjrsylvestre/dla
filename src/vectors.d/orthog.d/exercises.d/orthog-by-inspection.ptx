<exercisegroup cols="3" xml:id="exercisegroup-orthog-by-inspection">
<title>Creating orthogonal vectors</title>

<introduction><p>
	Use the guess-and-check method to determine a vector that is orthogonal to the given vector.
</p></introduction>

<exercise>

	<statement><p><m> (2,3) </m></p></statement>

	<answer><p>
		<m> (3,-2) </m> or <m> (-3,2) </m>
		(or any other scalar multiple of <m> (3,-2) </m>).
	</p></answer>

</exercise>

<exercise>

	<statement><p><m> (3,-1) </m></p></statement>

	<answer><p>
		<m> (1,3) </m> or <m> (-1,-3) </m>
		(or any other scalar multiple of <m> (1,3) </m>).
	</p></answer>

</exercise>

<exercise>

	<statement><p><m> (-5,-3) </m></p></statement>

	<answer><p>
		<m> (3,-5) </m> or <m> (-3,5) </m>
		(or any other scalar multiple of <m> (3,-5) </m>).
	</p></answer>

</exercise>

<exercise>

	<statement><p><m> (4,-6,2) </m></p></statement>

	<answer><p>
		<m> (1,0,-2) </m> or <m> (0,1,3) </m>
		(or any <term><xref ref="definition-vectors-linear-combination" text="custom">linear combination</xref></term>
		of those two vectors).
	</p></answer>

</exercise>

<exercise>

	<statement><p><m> (-1,0,1,3) </m></p></statement>

	<answer><p>
		<m> (0,1,0,0) </m> or <m> (1,0,1,0) </m> or <m> (3,0,0,1) </m>
		(or any <term><xref ref="definition-vectors-linear-combination" text="custom">linear combination</xref></term>
		of those three vectors).
	</p></answer>

</exercise>

</exercisegroup>
