<exercisegroup cols="2" xml:id="exercisegroup-vectors-geometric-vecs" xmlns:xi="http://www.w3.org/2001/XInclude">
<title>Vectors associated to directed line segments</title>

<introduction><p>
	In each case,
	compute the components of the vector <m>\uvec{v}</m> that corresponds to the directed line segment <m>\abray{PQ}</m>.
	Then draw both that directed line segment,
	and the vector <m>\uvec{v}</m> with its initial point at the origin.
</p></introduction>

<exercise>

	<statement><p> <m> P(3,5) </m>, <m> Q(7,4) </m> </p></statement>

	<answer>

		<p><m> \uvec{v} = (7 - 3, 4 - 5) = (4,-1) </m></p>

		<image width="51.7%">
			<latex-image label="image-vectors-exercises-geometric-vecs-answer-1">
				<xi:include href="geometric-vecs.d/answer-1.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vectors as representing directed line segments. </shortdescription>
			<description><p>
				A diagram consisting of a directed line segment,
				along with the corresponding vector <q>based</q> at the origin.
				The directed line segment <m>\abray{PQ}</m> extends from the point <m>P(3,5)</m> to the point <m>Q(7,4)</m>.
				The corresponding vector <m>\uvec{v}</m> is drawn as a directed line segment from the origin to the point <m>R(4,-1)</m>.
			</p></description>
		</image>

	</answer>

</exercise>

<exercise>

	<statement><p> <m> P(2,-1) </m>, <m> Q(-1,2) </m> </p></statement>

	<answer>

		<p><m> \uvec{v} = \bbrac{-1 - 2, 2 - (-1)} = (-3,3) </m></p>

		<image width="55.0%">
			<latex-image label="image-vectors-exercises-geometric-vecs-answer-2">
				<xi:include href="geometric-vecs.d/answer-2.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vectors as representing directed line segments. </shortdescription>
			<description><p>
				A diagram consisting of a directed line segment,
				along with the corresponding vector <q>based</q> at the origin.
				The directed line segment <m>\abray{PQ}</m> extends from the point <m>P(2,-1)</m> to the point <m>Q(-1,2)</m>.
				The corresponding vector <m>\uvec{v}</m> is drawn as a directed line segment from the origin to the point <m>R(-3,3)</m>.
			</p></description>
		</image>

	</answer>

</exercise>

<exercise>

	<statement><p> <m> P(3,6) </m>, <m> Q(-3,3) </m> </p></statement>

	<answer>

		<p><m> \uvec{v} = (-3 - 3, 3 - 6) = (-6,-3) </m></p>

		<image width="61.7%">
			<latex-image label="image-vectors-exercises-geometric-vecs-answer-3">
				<xi:include href="geometric-vecs.d/answer-3.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vectors as representing directed line segments. </shortdescription>
			<description><p>
				A diagram consisting of a directed line segment,
				along with the corresponding vector <q>based</q> at the origin.
				The directed line segment <m>\abray{PQ}</m> extends from the point <m>P(3,6)</m> to the point <m>Q(-3,3)</m>.
				The corresponding vector <m>\uvec{v}</m> is drawn as a directed line segment from the origin to the point <m>R(-6,-3)</m>.
			</p></description>
		</image>

	</answer>

</exercise>

<exercise>

	<statement><p>
		<m> P\left( - \dfrac{6}{5}, - \dfrac{ 2}{9} \right) </m>,
		<m> Q\left(   \dfrac{3}{5},   \dfrac{11}{9} \right) </m>
	</p></statement>

	<answer>

		<p><m>
			\uvec{v}
			= \left(
				\dfrac{ 3}{5} - \left(- \dfrac{6}{5} \right),
				\dfrac{11}{9} - \left(- \dfrac{2}{9} \right)
			\right)
			= \left( \dfrac{9}{5}, \dfrac{13}{9} \right)
		</m></p>

		<image width="65.5%">
			<latex-image label="image-vectors-exercises-geometric-vecs-answer-4">
				<xi:include href="geometric-vecs.d/answer-4.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vectors as representing directed line segments. </shortdescription>
			<description><p>
				A diagram consisting of a directed line segment,
				along with the corresponding vector <q>based</q> at the origin.
				The directed line segment <m>\abray{PQ}</m> extends from the point <m>P\left(-\frac{6}{5},-\frac{2}{9}\right)</m> to the point <m>Q\left(\frac{3}{5},\frac{11}{9}\right)</m>.
				The corresponding vector <m>\uvec{v}</m> is drawn as a directed line segment from the origin to the point <m>R(-6,-3)</m>.
			</p></description>
		</image>

	</answer>

</exercise>

</exercisegroup>
