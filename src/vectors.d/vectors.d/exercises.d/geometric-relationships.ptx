<exercisegroup cols="3" xml:id="exercisegroup-vectors-geometric-relationships" xmlns:xi="http://www.w3.org/2001/XInclude">
<title>Geometric relationships</title>

<introduction>

	<p>
	In each case,
	state whether the equality of vectors is true or false based on the diagram below.
	</p>

	<image width="77.9%">
		<latex-image label="image-vectors-exercises-geometric-relationships">
			<xi:include href="geometric-relationships.d/diagram.tex" parse="text" />
		</latex-image>
		<shortdescription> Diagram of several vectors in various geometric relationships. </shortdescription>
		<description><p>
			A planar diagram consisting of six points,
			<m> P,Q,R,S,T,U </m>.
			Quadrilateral <m> \abcdquad{PQTS} </m> is a parallelogram.
			Side <m> \absegment{PQ} </m> is extended past <m> Q </m> to a point <m> R</m>
			and side <m> \absegment{ST} </m> is extended past <m> T </m> to a point <m> U </m>
			so that quadrilateral <m> \abcdquad{QRUS} </m> is also a parallelogram,
			with <m> T </m> at the midpoint of side <m> \absegment{SU} </m>.
			Finally,
			the following directed line segments are drawn in:
			<ul>
				<li> <m> \abray{PQ} </m>, labelled as vector <m> \uvec{a} </m>. </li>
				<li> <m> \abray{PS} </m>, labelled as vector <m> \uvec{b} </m>. </li>
				<li> <m> \abray{SQ} </m>, labelled as vector <m> \uvec{c} </m>. </li>
				<li> <m> \abray{TS} </m>, labelled as vector <m> \uvec{d} </m>. </li>
				<li> <m> \abray{QT} </m>, labelled as vector <m> \uvec{e} </m>. </li>
				<li> <m> \abray{TU} </m>, labelled as vector <m> \uvec{f} </m>. </li>
				<li> <m> \abray{QR} </m>, labelled as vector <m> \uvec{g} </m>. </li>
				<li> <m> \abray{RT} </m>, labelled as vector <m> \uvec{h} </m>. </li>
				<li> <m> \abray{UR} </m>, labelled as vector <m> \uvec{i} </m>. </li>
			</ul>
		</p></description>
	</image>

</introduction>

<exercise>

	<statement><p> <m> \uvec{f} = \uvec{a} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> - \uvec{d} = \uvec{a} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{c} + \uvec{i} = \zerovec </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{b} + \uvec{c} = \uvec{a} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{d} + \uvec{e} = \uvec{i} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{e} - \uvec{g} = \uvec{h} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{i} - \uvec{h} = \uvec{f} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{f} - \uvec{d} = \uvec{g} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> 2 \uvec{a} = \uvec{g} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{e} + \uvec{f} - \uvec{i} = \uvec{g} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{b} - \uvec{d} - \uvec{e} = \uvec{a} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{c} + \uvec{g} + \uvec{i} = 2 \uvec{a} </m> </p></statement>

	<answer><p> True. </p></answer>

</exercise>

</exercisegroup>
