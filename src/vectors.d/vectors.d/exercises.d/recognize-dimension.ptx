<exercisegroup cols="3" xml:id="exercisegroup-vectors-recognize-dimension">
<title>Recognizing the dimension of a vector</title>

<introduction>

	<p>
	In each case,
	determine the value of <m> n </m> for which the given vector is a member of the collection <m> \R^n </m>.
	</p>

</introduction>

<exercise>

	<statement><p><m> \uvec{a} = (4,0,6) </m></p></statement>

	<answer><p><m> n = 3 </m></p></answer>

</exercise>

<exercise>

	<statement><p><m> \uvec{b} = (-2,4) </m></p></statement>

	<answer><p><m> n = 2 </m></p></answer>

</exercise>

<exercise>

	<statement><p><m> \uvec{c} = (\pi,\sqrt{2},-\pi,e) </m></p></statement>

	<answer><p><m> n = 4 </m></p></answer>

</exercise>

</exercisegroup>
