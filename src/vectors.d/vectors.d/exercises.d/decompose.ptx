<exercisegroup cols="2" xml:id="exercisegroup-vectors-decompose">
<title>Decomposing vectors in <m>\R^n</m> in terms of standard basis vectors</title>

<introduction><p>
	In each case,
	express the vector <m>\uvec{v}</m>
	as a <term><xref ref="definition-vectors-linear-combination" text="custom">linear combination</xref></term>
	of the <term><xref ref="definition-vectors-std-basis" text="title"/></term> <m>\uvec{e}_1,\dotsc,\uvec{e}_n</m>.
</p></introduction>

<exercise>

	<statement><p> <m> \uvec{v} = (6,5,2) </m> </p></statement>

	<answer> <p><m> (6,5,2) = 6 \uvec{e}_1 + 5 \uvec{e}_2 + 2 \uvec{e}_3 </m></p> </answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{v} = (0,-3,6) </m> </p></statement>

	<answer><p><m> (0,-3,6) = 0 \uvec{e}_1 + (-3) \uvec{e}_2 + 6 \uvec{e}_3 </m></p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{v} = (5,-5,2,1) </m> </p></statement>

	<answer><p><m> (5,-5,2,1) = 5 \uvec{e}_1 + (-5) \uvec{e}_2 + 2 \uvec{e}_3 + 1 \uvec{e}_4 </m></p></answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{v} = (-6,-1,0,3) </m> </p></statement>

	<answer><p><m> (-6,-1,0,3) = (-6) \uvec{e}_1 + (-1) \uvec{e}_2 + 0 \uvec{e}_3 + 3 \uvec{e}_4 </m></p></answer>

</exercise>

</exercisegroup>
