<exercisegroup cols="2" xml:id="exercisegroup-vectors-arithmetic">
<title>Vector arithmetic</title>

<!-- TODO might not look great in LaTeX output with cols="2" -->

<introduction><p> In each case, carry out the vector operation(s). </p></introduction>


<!-- addition -->

<exercise>
	<statement><p><m> (-1,0) + (0,5) </m></p></statement>
	<answer><p><m>(-1,5)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (7,3) + (2,7) </m></p></statement>
	<answer><p><m>(9,10)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-3,8,1) + (7,8,-3) </m></p></statement>
	<answer><p><m>(4,16,-2)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-3,0,0) + (0,8,0) + (0,0,3) </m></p></statement>
	<answer><p><m>(-3,8,3)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-8,1,0,5) + (-3,0,-1,5) </m></p></statement>
	<answer><p><m>(-11,1,-1,10)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-3,0,0,0) + (0,8,0,0), + (0,0,-2,0) + (0,0,0,5) </m></p></statement>
	<answer><p><m>(-3,8,-2,5)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (1,-5,9,0,3) + (2,4,-7,-8,1) </m></p></statement>
	<answer><p><m>(3,-1,2,-8,4)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (8,0,0,0,0) + (0,4,0,0,0) + (0,0,-9,0,0) + (0,0,0,-7,0) + (0,0,0,0,7) </m></p></statement>
	<answer><p><m>(8,4,-9,-7,7)</m></p></answer>
</exercise>


<!-- subtraction -->

<exercise>
	<statement><p><m> (5,2) - (1,3) </m></p></statement>
	<answer><p><m>(4,-1)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (7,-9,-6) - (7,3,-2) </m></p></statement>
	<answer><p><m>(0,-12,-4)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-4,1,-2,6) - (8,9,-2,-4) </m></p></statement>
	<answer><p><m>(-12,-8,0,10)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (8,9,7,2,-3) - (-9,2,0,4,8) </m></p></statement>
	<answer><p><m>(17,7,7,-2,-11)</m></p></answer>
</exercise>


<!-- scaling -->

<exercise>
	<statement><p><m> -7 (1,3) </m></p></statement>
	<answer><p><m>(-7,-21)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> \dfrac{6}{5} (-9,4) </m></p></statement>
	<answer><p><m> \left( - \dfrac{54}{5}, \frac{24}{5} \right)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> 3 (5,6,1) </m></p></statement>
	<answer><p><m>(15,18,3)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> 7 \left(1,2,-4, \dfrac{8}{7} \right) </m></p></statement>
	<answer><p><m>(7,14,-28,8)</m></p></answer>
</exercise>


<!-- linear combinations -->

<exercise>
	<statement><p><m> 2 (1,0) + (-3) (0,1) </m></p></statement>
	<answer><p><m>(2,-3)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> 6 (-1,2) + 7 (-2,-3) </m></p></statement>
	<answer><p><m>(-20,-9)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> 8 (-3,1,5) + 7 (-1,0,-3) </m></p></statement>
	<answer><p><m>(-31,8,19)</m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-5) (2,-4,9,-7) + 5 (-8,-7,-3,-7) + 7 (3,5,-5,-8) </m></p></statement>
	<answer><p><m>(-29,20,-95,-56)</m></p></answer>
</exercise>

</exercisegroup>
