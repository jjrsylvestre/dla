<exercisegroup cols="2" xml:id="exercisegroup-vectors-geometric-scale" xmlns:xi="http://www.w3.org/2001/XInclude">
<title>Geometric scaling of vectors</title>

<introduction><p>
	In each case,
	draw both the vector <m>\uvec{v}</m> and the scaled vector <m>k \uvec{v}</m> in the Cartesian plane with initial points at the origin.
	Then calculate <m>k \uvec{v}</m> and verify that its terminal point on your diagram agrees with your calculation.
</p></introduction>

<exercise>

	<statement><p> <m>\displaystyle \uvec{v} = (-2,0) </m>, <m>k = 5</m> </p></statement>

	<answer>

		<image width="56.1%">
			<latex-image label="image-vectors-exercises-geometric-scale-answer-1">
				<xi:include href="geometric-scale.d/answer-1.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating scaling of a vector. </shortdescription>
			<description><p>
				A diagram consisting of two parallel directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(-2,0)</m>.
				The other represents the scaled vector <m>5 \uvec{v}</m>,
				and extends from the origin to the point <m>P'(-10,0)</m>.
			</p></description>
		</image>

		<p><m> 5 \uvec{v} = 5 (2,0) = (10,0) </m></p>

	</answer>

</exercise>

<exercise>

	<statement><p> <m>\displaystyle \uvec{v} = \left(0, \frac{5}{4}\right) </m>, <m>k = 3</m> </p></statement>

	<answer>

		<image width="25.8%">
			<latex-image label="image-vectors-exercises-geometric-scale-answer-2">
				<xi:include href="geometric-scale.d/answer-2.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating scaling of a vector. </shortdescription>
			<description><p>
				A diagram consisting of two parallel directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P\left(0,\frac{5}{4}\right)</m>.
				The other represents the scaled vector <m>5 \uvec{v}</m>,
				and extends from the origin to the point <m>P'\left(0,\frac{15}{4}\right)</m>.
			</p></description>
		</image>

		<p><m> 3 \uvec{v} = 3 \left(0,\frac{5}{4}\right) = \left(0,\frac{15}{4}\right) </m></p>

	</answer>

</exercise>

<exercise>

	<statement><p> <m>\displaystyle \uvec{v} = (2, 6) </m>, <m>k = \dfrac{2}{3}</m> </p></statement>

	<answer>

		<image width="32.9%">
			<latex-image label="image-vectors-exercises-geometric-scale-answer-3">
				<xi:include href="geometric-scale.d/answer-3.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating scaling of a vector. </shortdescription>
			<description><p>
				A diagram consisting of two parallel directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(2,6)</m>.
				The other represents the scaled vector <m>\frac{2}{3} \uvec{v}</m>,
				and extends from the origin to the point <m>P'\left(\frac{4}{3},4\right)</m>.
			</p></description>
		</image>

		<p><m>\displaystyle \frac{2}{3} \uvec{v} = \frac{2}{3} (2,6) = \left(\frac{4}{3},4\right) </m></p>

	</answer>

</exercise>

<exercise>

	<statement><p> <m>\displaystyle \uvec{v} = (-2, 3) </m>, <m>k = -\dfrac{3}{2}</m> </p></statement>

	<answer>

		<image width="51.7%">
			<latex-image label="image-vectors-exercises-geometric-scale-answer-4">
				<xi:include href="geometric-scale.d/answer-4.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating scaling of a vector. </shortdescription>
			<description><p>
				A diagram consisting of two parallel directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(-2,3)</m>.
				The other represents the scaled vector <m>- \frac{3}{2} \uvec{v}</m>,
				and extends from the origin to the point <m>P'\left(3,-\frac{9}{2}\right)</m>.
			</p></description>
		</image>

		<p><m>\displaystyle - \frac{3}{2} \uvec{v} = - \frac{3}{2} (-2,3) = \left(3, - \frac{9}{3}\right) </m></p>

	</answer>

</exercise>

</exercisegroup>
