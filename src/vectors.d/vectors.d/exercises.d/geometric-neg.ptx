<exercisegroup cols="2" xml:id="exercisegroup-vectors-geometric-neg" xmlns:xi="http://www.w3.org/2001/XInclude">
<title>Geometric negation of vectors</title>

<introduction><p>
	In each case,
	draw both the vector <m>\uvec{v}</m> and its negative in the Cartesian plane with initial points at the origin.
	Then calculate the negative vector <m>- \uvec{v}</m> and verify that its terminal point on your diagram agrees with your calculation.
</p></introduction>

<exercise>

	<statement><p> <m> \uvec{v} = (5,0) </m> </p></statement>

	<answer>

		<image width="95%">
			<latex-image label="image-vectors-exercises-geometric-neg-answer-1">
				<xi:include href="geometric-neg.d/answer-1.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vector negation. </shortdescription>
			<description><p>
				A diagram consisting of two oppositely directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(5,0)</m>.
				The other represents the negative vector <m>- \uvec{v}</m>,
				and extends from the origin to the point <m>P'(-5,0)</m>.
			</p></description>
		</image>

		<p><m> - \uvec{v} = - (5,0) = (-5,0) </m></p>

	</answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{v} = (0,-3) </m> </p></statement>

	<answer>

		<image width="22.6%">
			<latex-image label="image-vectors-exercises-geometric-neg-answer-2">
				<xi:include href="geometric-neg.d/answer-2.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vector negation. </shortdescription>
			<description><p>
				A diagram consisting of two oppositely directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(0,-3)</m>.
				The other represents the negative vector <m>- \uvec{v}</m>,
				and extends from the origin to the point <m>P'(0,3)</m>.
			</p></description>
		</image>

		<p><m> - \uvec{v} = - (0,-3) = (0,3) </m></p>

	</answer>

</exercise>


<exercise>

	<statement><p> <m> \uvec{v} = (6,1) </m> </p></statement>

	<answer>

		<image width="99.4%">
			<latex-image label="image-vectors-exercises-geometric-neg-answer-3">
				<xi:include href="geometric-neg.d/answer-3.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vector negation. </shortdescription>
			<description><p>
				A diagram consisting of two oppositely directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(6,1)</m>.
				The other represents the negative vector <m>- \uvec{v}</m>,
				and extends from the origin to the point <m>P'(-6,-1)</m>.
			</p></description>
		</image>

		<p><m> - \uvec{v} = - (6,1) = (-6,-1) </m></p>

	</answer>

</exercise>

<exercise>

	<statement><p> <m> \uvec{v} = (-3,2) </m> </p></statement>

	<answer>

		<image width="62%">
			<latex-image label="image-vectors-exercises-geometric-neg-answer-4">
				<xi:include href="geometric-neg.d/answer-4.tex" parse="text" />
			</latex-image>
			<shortdescription> Diagram illustrating vector negation. </shortdescription>
			<description><p>
				A diagram consisting of two oppositely directed line segments in the <m>xy</m>-plane.
				One represents a vector labelled <m>\uvec{v}</m>,
				and extends from the origin to the point <m>P(-3,2)</m>.
				The other represents the negative vector <m>- \uvec{v}</m>,
				and extends from the origin to the point <m>P'(3,-2)</m>.
			</p></description>
		</image>

		<p><m> - \uvec{v} = - (-3,2) = (3,-2) </m></p>

	</answer>

</exercise>


</exercisegroup>
