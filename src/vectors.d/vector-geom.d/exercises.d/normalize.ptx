<exercisegroup cols="3" xml:id="exercisegroup-vector-geom-normalize">
<title>Normalizing vectors</title>

<introduction><p> Compute the two unit vectors that are parallel to the given vector. </p></introduction>

<exercise>
	<statement><p><m> (0,5) </m></p></statement>
	<answer><p>
		<m> (0,1) </m>,
		<m> (0,-1) </m>
	</p></answer>
</exercise>

<exercise>
	<statement><p><m> (4,2) </m></p></statement>
	<answer><p>
		<m> \left(   \frac{2}{\sqrt{5}},   \frac{1}{\sqrt{5}} \right) </m>,
		<m> \left( - \frac{2}{\sqrt{5}}, - \frac{1}{\sqrt{5}} \right) </m>
	</p></answer>
</exercise>

<exercise>
	<statement><p><m> (-6,7) </m></p></statement>
	<answer><p>
		<m> \left( - \frac{6}{\sqrt{85}},   \frac{7}{\sqrt{85}} \right) </m>,
		<m> \left(   \frac{6}{\sqrt{85}}, - \frac{7}{\sqrt{85}} \right) </m>
	</p></answer>
</exercise>

<exercise>
	<statement><p><m> (6,0,-3) </m></p></statement>
	<answer><p>
		<m> \left(   \frac{2}{\sqrt{5}}, 0, - \frac{1}{\sqrt{5}} \right) </m>,
		<m> \left( - \frac{2}{\sqrt{5}}, 0,   \frac{1}{\sqrt{5}} \right) </m>
	</p></answer>
</exercise>

<exercise>
	<statement><p><m> (-3,4,8,4) </m></p></statement>
	<answer><p>
		<m> \left( - \frac{3}{\sqrt{105}},   \frac{4}{\sqrt{105}},   \frac{8}{\sqrt{105}},   \frac{4}{\sqrt{105}} \right) </m>,
		<m> \left(   \frac{3}{\sqrt{105}}, - \frac{4}{\sqrt{105}}, - \frac{8}{\sqrt{105}}, - \frac{4}{\sqrt{105}} \right) </m>
	</p></answer>
</exercise>

<exercise>
	<statement><p><m> (1,-9,5,0,-6) </m></p></statement>
	<answer><p>
		<m> \left(   \frac{1}{\sqrt{143}}, - \frac{9}{\sqrt{143}},   \frac{5}{\sqrt{143}}, 0, - \frac{6}{\sqrt{143}} \right) </m>,
		<m> \left( - \frac{1}{\sqrt{143}},   \frac{9}{\sqrt{143}}, - \frac{5}{\sqrt{143}}, 0,   \frac{6}{\sqrt{143}} \right) </m>
	</p></answer>
</exercise>

</exercisegroup>
