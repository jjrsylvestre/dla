<exercisegroup xml:id="exercisegroup-vector-geom-dot-prod">
<title>Computing dot product</title>

<introduction><p> Compute <m> \udotprod{u}{v} </m>. </p></introduction>

<exercise>

	<statement><p>
		<m> \uvec{u} = (-1, 2) </m>,
		<m> \uvec{v} = ( 2, 6) </m>
	</p></statement>

	<answer><p><m> 10 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = (-2, 2) </m>,
		<m> \uvec{v} = ( 5, 0) </m>
	</p></statement>

	<answer><p><m> -10 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = ( 4, 9, 6) </m>,
		<m> \uvec{v} = ( 5,-9,-7) </m>
	</p></statement>

	<answer><p><m> -103 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = ( 6, 3, 4) </m>,
		<m> \uvec{v} = ( 0,-1, 6) </m>
	</p></statement>

	<answer><p><m> 21 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = (-5, 1,-1, 0) </m>,
		<m> \uvec{v} = (-4, 4,-3, 1) </m>
	</p></statement>

	<answer><p><m> 27 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = \left( \frac{3}{2},       -1     ,  0, \frac{1}{5}, \frac{1}{2} \right) </m>,
		<m> \uvec{v} = \left(      0     , - \frac{5}{2}, -5, \frac{1}{2},      1      \right) </m>
	</p></statement>

	<answer><p><m> 31/10 </m></p></answer>

</exercise>

</exercisegroup>
