<exercisegroup cols="2" xml:id="exercisegroup-vector-geom-compute-angle">
<title>Computing angles</title>

<introduction><p>
	Compute the angle between <m> \uvec{u} </m> and <m> \uvec{v} </m>,
	Give your answer in radians to two decimal places.
</p></introduction>

<exercise>

	<statement><p>
		<m> \uvec{u} = (5,-2) </m>,
		<m> \uvec{v} = (5,-4) </m>
	</p></statement>

	<answer><p><m> \theta \approx 0.29 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = (4, 5) </m>,
		<m> \uvec{v} = (3,-4) </m>
	</p></statement>

	<answer><p><m> \theta \approx 1.82 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = (4,-3,-6) </m>,
		<m> \uvec{v} = (2, 2, 0) </m>
	</p></statement>

	<answer><p><m> \theta \approx 1.48 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = (-6,1, 3) </m>,
		<m> \uvec{v} = ( 4,3,-5) </m>
	</p></statement>

	<answer><p><m> \theta \approx 2.42 </m></p></answer>

</exercise>

<exercise>

	<statement><p>
		<m> \uvec{u} = (6,-1,-6,-1) </m>,
		<m> \uvec{v} = (1, 0, 3, 3) </m>
	</p></statement>

	<answer><p><m> \theta \approx 1.98 </m></p></answer>

</exercise>

<exercise>
<!-- todo -->
	<statement><p>
		<m> \uvec{u} = (3,-2, 3,5,-3) </m>,
		<m> \uvec{v} = (4, 6,-4,5,-2) </m>
	</p></statement>

	<answer><p><m> \theta \approx 1.31 </m></p></answer>

</exercise>

</exercisegroup>
