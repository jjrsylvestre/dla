<exercisegroup cols="2" xml:id="exercisegroup-vector-geom-compute-angle">
<title>Cauchy-Schwarz inequality and computing angles</title>

<introduction><p>
	In each case:
	<ol>

		<li> Verify that <m> \uvec{u} </m> and <m> \uvec{v} </m> satisfy the <xref ref="theorem-vector-geom-cauchy-schwarz" text="title" />. </li>

		<li>
			Compute the angle between <m> \uvec{u} </m> and <m> \uvec{v} </m>.
			Give your answer in radians to two decimal places.
		</li>

	</ol>
</p></introduction>

<exercise xml:id="exercise-vector-geom-compute-angle-R2-1">

	<statement><p>
		<m> \uvec{u} = (5,-2) </m>,
		<m> \uvec{v} = (5,-4) </m>
	</p></statement>

	<answer><p><ol>

		<li>
			<m> \abs{\udotprod{u}{v}} = 33 </m>, <m> \unorm{u} = \sqrt{29} </m>, and <m> \unorm{v} = \sqrt{41} </m>.
			Since <m> {33}^2 \lt 29 \cdot 41 </m>,
			it is true that <m> \abs{\udotprod{u}{v}} \le \unorm{u} \unorm{v} </m>.
		</li>

		<li><m> \theta \approx 0.29 </m></li>

	</ol></p></answer>

</exercise>

<exercise xml:id="exercise-vector-geom-compute-angle-R2-2">

	<statement><p>
		<m> \uvec{u} = (4, 5) </m>,
		<m> \uvec{v} = (3,-4) </m>
	</p></statement>

	<answer><p><ol>

		<li>
			<m> \abs{\udotprod{u}{v}} = 8 </m>, <m> \unorm{u} = \sqrt{41} </m>, and <m> \unorm{v} = 5 </m>.
			Since <m> 8^2 \lt 41 \cdot 5^2 </m>,
			it is true that <m> \abs{\udotprod{u}{v}} \le \unorm{u} \unorm{v} </m>.
		</li>

		<li><m> \theta \approx 1.82 </m></li>
	</ol></p></answer>

</exercise>

<exercise xml:id="exercise-vector-geom-compute-angle-R3-1">

	<statement><p>
		<m> \uvec{u} = (4,-3,-6) </m>,
		<m> \uvec{v} = (2, 2, 0) </m>
	</p></statement>

	<answer><p><ol>

		<li>
			<m> \abs{\udotprod{u}{v}} = 2 </m>, <m> \unorm{u} = \sqrt{61} </m>, and <m> \unorm{v} = 2 \sqrt{2} </m>.
			Since <m> 2^2 \lt 61 \cdot 2^2 \cdot 2 </m>,
			it is true that <m> \abs{\udotprod{u}{v}} \le \unorm{u} \unorm{v} </m>.
		</li>

		<li><m> \theta \approx 1.48 </m></li>

	</ol></p></answer>

</exercise>

<exercise xml:id="exercise-vector-geom-compute-angle-R3-2">

	<statement><p>
		<m> \uvec{u} = (-6,1, 3) </m>,
		<m> \uvec{v} = ( 4,3,-5) </m>
	</p></statement>

	<answer><p><ol>

		<li>
			<m> \abs{\udotprod{u}{v}} = 36 </m>, <m> \unorm{u} = \sqrt{46} </m>, and <m> \unorm{v} = 5 \sqrt{2} </m>.
			Since <m> {36}^2 \lt 36 \cdot 5^2 \cdot 2 </m>,
			it is true that <m> \abs{\udotprod{u}{v}} \le \unorm{u} \unorm{v} </m>.
		</li>

		<li><m> \theta \approx 2.42 </m></li>

	</ol></p></answer>

</exercise>

<exercise xml:id="exercise-vector-geom-compute-angle-R4">

	<statement>

		<p><m> \uvec{u} = (6,-1,-6,-1) </m>,</p>

		<p><m> \uvec{v} = (1, 0, 3, 3) </m></p>

	</statement>

	<answer><p><ol>

		<li>
			<m> \abs{\udotprod{u}{v}} = 15 </m>, <m> \unorm{u} = \sqrt{74} </m>, and <m> \unorm{v} = \sqrt{19} </m>.
			Since <m> {15}^2 \lt 74 \cdot 19 </m>,
			it is true that <m> \abs{\udotprod{u}{v}} \le \unorm{u} \unorm{v} </m>.
		</li>

		<li><m> \theta \approx 1.98 </m></li>

	</ol></p></answer>

</exercise>

<exercise xml:id="exercise-vector-geom-compute-angle-R5">

	<statement>

		<p><m> \uvec{u} = (3,-2, 3,5,-3) </m>,</p>

		<p><m> \uvec{v} = (4, 6,-4,5,-2) </m></p>

	</statement>

	<answer><p><ol>

		<li>
			<m> \abs{\udotprod{u}{v}} = 19 </m>, <m> \unorm{u} = 2 \sqrt{14} </m>, and <m> \unorm{v} = \sqrt{97} </m>.
			Since <m> {19}^2 \lt 2^2 \cdot 14 \cdot 97 </m>,
			it is true that <m> \abs{\udotprod{u}{v}} \le \unorm{u} \unorm{v} </m>.
		</li>

		<li><m> \theta \approx 1.31 </m></li>

	</ol></p></answer>

</exercise>

</exercisegroup>
