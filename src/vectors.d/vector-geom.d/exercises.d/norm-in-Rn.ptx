<exercisegroup cols="3" xml:id="exercisegroup-vector-geom-norm-in-Rn">
<title>Norm in <m> \R^n </m></title>

<introduction><p> Compute the norm of the vector. </p></introduction>

<exercise>
	<statement><p><m> (4,6,0) </m></p></statement>
	<answer><p><m> 2 \sqrt{13} </m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (0,7,-1) </m></p></statement>
	<answer><p><m> 5 \sqrt{2} </m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (-5,\sqrt{3},8) </m></p></statement>
	<answer><p><m> 2 \sqrt{23} </m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (1,-3,8,-6) </m></p></statement>
	<answer><p><m> \sqrt{110} </m></p></answer>
</exercise>

<exercise>
	<statement><p><m> \left( \frac{7}{6}, -\frac{8}{5}, -\frac{8}{5}, -\frac{6}{5}, \frac{5}{6} \right) </m></p></statement>
	<answer><p><m> \dfrac{1}{15} \, \sqrt{\dfrac{3877}{2}} </m></p></answer>
</exercise>

<exercise>
	<statement><p><m> (2,0,1,-1,2,5) </m></p></statement>
	<answer><p><m> \sqrt{35} </m></p></answer>
</exercise>

</exercisegroup>
