<exercisegroup>
	<title>Using the Subspace Test </title>

	<introduction><p>
		In each of the following, check each part of the <xref ref="procedure-subspaces-concepts-test" text="title" /> for subcollection <m>W</m> inside vector space <m>V</m>.
		<ul>
			<li> If you think a part of the <xref ref="procedure-subspaces-concepts-test" text="title" /> is <em>true</em>, <alert>justify it without resorting to examples</alert>. </li>
			<li> If you think a part of the <xref ref="procedure-subspaces-concepts-test" text="title" /> is <em>false</em>, <alert>provide an explicit example that demonstrates it</alert>. </li>
		</ul>
		</p></introduction>

	<exercise>
		<statement><p> <m>V=\mathbb{R}^2</m>, <m>W=</m>  the subcollection of vectors that are orthogonal to <m>
			    \begin{bmatrix}1\\4\end{bmatrix}
			</m>.</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

	<exercise>
		<statement><p><m>V=\mathbb{R}^2</m>, <m>W=</m> the subcollection of vectors <m>
			    (x_1,x_2)
			</m>
			where
			<m>
			    x_{1}^2-x_{2}^2=0
			</m>.</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

	<exercise>
		<statement><p><m>V=\mathbb{R}^2</m>, <m>W=</m> the subcollection of vectors <m>
			     (x_1,x_2)
			</m>
			where
			<m>
			    x_{1}+2x_{2}\geq 0.
			</m></p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

		<exercise>
		<statement><p><m>V=M_{2\times 2}(\mathbb{R})</m>, <m>W=</m> the subcollection of matrices <m>A</m> where <m>A^2</m> is the zero matrix.
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

		<exercise>
		<statement><p><m>V=M_{2\times 2}(\mathbb{R})</m>, <m>W=</m> the subcollection of matrices <m>A</m> where <m>\det(A)\geq 0</m>.
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

	<exercise>
		<statement><p><m>V=M_{2\times 2}(\mathbb{R})</m>, <m>W=</m> the subcollection of matrices <m>A</m> where <m>AX=XA</m> for <m>X=\begin{bmatrix}1 &amp; 2\\2 &amp;4\end{bmatrix}</m>.
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

	<exercise>
		<statement><p><m>V=M_{2\times 2}(\mathbb{R})</m>, <m>W=</m> the subcollection of upper triangular matrices.
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

		<exercise>
		<statement><p>
			<m>V=\poly_2(\R)</m>,  <m> W=</m> the subcollection of polynomials where <m>p(1)\geq 0</m> (recall: <m>p(1)</m> means to evaluate the polynomial <m>p(x)</m> at <m>x=1</m>).
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

			<exercise>
		<statement><p>
			<m>V=\poly_2(\R)</m>,  <m> W=</m> the subcollection of polynomials where <md>\int_{-1}^{1} p(x)dx=0.</md>
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

	<exercise>
		<statement><p>
			<m>V=\poly_2(\R)</m>,  <m> W=</m> the subcollection of polynomials where <m>p'(0)+p'(1)=0</m> (recall: <m>p'(x)=\frac{d}{dx}p(x)</m> is the derivative of <m>p(x)</m>).
			</p></statement>
		<answer><p>  </p>
		</answer>
	</exercise>

</exercisegroup>
