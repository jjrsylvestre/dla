## EDIT REASON
## Split into two parts

# DESCRIPTION
# Find two vectors for which as the transition of two vectors for a given transformation. Also, find 
# the transition matrix from one polynomial basis to another.
# ENDDESCRIPTION

## DBsubject(Linear algebra)
## DBchapter(Abstract vector spaces)
## DBsection(Coordinate vectors and change of basis)
## Institution(University of Missouri-Columbia)
## Author(Rick Lynch)
## Level(2)
## KEYWORDS('matrices', 'matrix', 'transition matrix')


###########################################################################
# initialization 
###########################################################################
DOCUMENT();
loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",
  "PGcourse.pl"
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;


###########################################################################
# setup contexts and variables 
###########################################################################
Context("Matrix");
$a = non_zero_random(-15,15);
$b = non_zero_random(-15,15);
$c = non_zero_random(-15,15);
$d = non_zero_random(-15,15);

$p1 = Formula("$a");
$p2 = Formula("$b x")->reduce;
$p3 = Formula("$c x^2")->reduce;
$p4 = Formula("$d x^3")->reduce;

$A = Matrix([$a,-$b,0,0],[0,$b,-$c,0],[0,0,$c,-$d],[0,0,0,$d]);


###########################################################################
# state the problem 
###########################################################################
Context()->texStrings;
BEGIN_TEXT
Let \(P_4\) be the vectors space of all polynomials of degree less than four. Find the transition matrix \(A\) representing the change of basis from the ordered basis 
$PAR
$BCENTER
\($LBRACE $p1, $p2, $p3, $p4 $RBRACE\) 
$ECENTER
to 
$BCENTER
\($LBRACE 1, 1+x, 1+x +x^2, 1+x+x^2+x^3 $RBRACE\).
$ECENTER
$BR
$BCENTER
\{ mbox( '\(A =\)', answer_matrix(4,4,5) ) \}
$ECENTER
END_TEXT
Context()->normalStrings;


###########################################################################
# check the answer  
###########################################################################
for ($i = 1; $i <= 4; $i++) {
  for ($j = 1; $j <= 4; $j++) {
    ANS($A->element($i,$j)->cmp());
  }
}


###########################################################################
# solution
###########################################################################
Context()->texStrings;
BEGIN_SOLUTION
${BBOLD}Solution:${EBOLD} 
Here, we first find the coordinate vector for each \($p1\), \($p2\), \($p3\), and \($p4\) with respect to the ordered basis \($LBRACE 1, 1+x, 1+x +x^2, 1+x+x^2+x^3 $RBRACE\). We get that the transition matrix in question is
$PAR
\[
A = $A
\]
END_SOLUTION
Context()->normalStrings;

# Created in 2012. 
# Desc: Find two vectors for which as the transition of two vectors for a given transformation. Also, find the transition matrix from one polynomial basis to another.
ENDDOCUMENT();
