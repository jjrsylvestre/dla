DOCUMENT();

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGcourse.pl"
);
TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context('Matrix');

$a = random(2,9,1);
$b = random(2,9,1);
if ($b == $a) { $b = $b+1; } 

$A = Matrix([[$a,-1*$b],[$b,$a]]);

Context()->texStrings;
BEGIN_TEXT
Recall that the field of complex numbers \(\mathbb{C}\) can be considered as a two-dimensional real vector space:
\(\mathbb{C} = \operatorname{Span}_{\mathbb{R}} \lbrace 1, \mathrm{i} \rbrace\).
$PAR
In this context, multiplication by a fixed complex number is a linear operator on \(\mathbb{C}\).
$PAR
Determine the matrix of the linear operator \(T(z) = ($a+$b \mathrm{i}) z \) on \({\mathbb C}\)
with respect to the standard basis \( S = \lbrace 1, i \rbrace \).
$PAR
\({[T]}_S = \) \{ $A->ans_array \}
$BR
${BITALIC}NOTE:${EITALIC} Your answer should be a real matrix, as we are dealing with a real vector space.
END_TEXT
Context()->normalStrings;

ANS($A->cmp);
;
ENDDOCUMENT();
