## EDIT REASON:
## 1. Add bold vector notation.
## 2. Change wording to a projection problem, turns out v is not actually in W !
##     (This is a bug that is fixed in the github OPL.)

## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## Tagged by tda2d

## DBsubject(Linear algebra)
## DBchapter(Inner products)
## DBsection(Orthogonal and orthonormal sets)
## Institution(TCNJ)
## TitleText1('Linear Algebra with Applications')
## AuthorText1('Jeffrey Holt')
## EditionText1('1')
## Section1('8.1')
## Problem1('')
## KEYWORDS('inner product' 'orthogonal' 'projection' 'subspace')
DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
"PG.pl",
"PGbasicmacros.pl",
"PGchoicemacros.pl",
"PGanswermacros.pl",
"PGgraphmacros.pl",
"PGmatrixmacros.pl", 
"PGnumericalmacros.pl",
"PGauxiliaryFunctions.pl",
"PGcourse.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

$a = non_zero_random(-4,4,1);
$b = non_zero_random(-4,4,1);
$c = non_zero_random(-3,3,1);
$n = non_zero_random(-4,4,1);
$m = non_zero_random(-4,4,1);

$x1 = $a;
$x2 = $c;
$x3 = $b;
$x4 = 0;

$y1 = $b;
$y2 = 0;
$y3 = - $a;
$y4 = 1;

$z1 = $n * $c;
$z2 = - $m * $b - $n * $a;
$z3 = $m * $c;
$z4 = $a * $m * $c - $b * $n * $c;

$v1 = random(-10,10,1);
$v2 = random(-10,10,1);
$v3 = random(-10,10,1);
$v4 = random(-10,10,1);

$vx = $v1 * $x1 + $v2 * $x2 + $v3 * $x3 + $v4 * $x4;
$norm2x = $x1 * $x1 + $x2 * $x2 + $x3 * $x3 + $x4 * $x4; 
$c1 = $vx/$norm2x; 

$vy = $v1 * $y1 + $v2 * $y2 + $v3 * $y3 + $v4 * $y4;
$norm2y = $y1 * $y1 + $y2 * $y2 + $y3 * $y3 + $y4 * $y4; 
$c2 = $vy/$norm2y;

$vz = $v1 * $z1 + $v2 * $z2 + $v3 * $z3 + $v4 * $z4;
$norm2z = $z1 * $z1 + $z2 * $z2 + $z3 * $z3 + $z4 * $z4; 
$c3 = $vz/$norm2z;

BEGIN_TEXT

\{ mbox( 'Given \(\vec{v}=\)', display_matrix([[$v1], [$v2], [$v3], [$v4]]), ',' ) \} 
compute the orthogonal projection of \(\vec{v}\) onto the subspace \(W\) spanned by  
\{ mbox( '\(\vec{u}_{1}=\)', display_matrix([[$x1], [$x2], [$x3], [$x4]]), ', \(\vec{u}_{2}=\)', display_matrix([[$y1], [$y2], [$y3], [$y4]]), 'and \(\vec{u}_{3}=\)', display_matrix([[$z1], [$z2], [$z3], [$z4]]), ',' ) \}
and express your answer as a linear combination of these spanning vectors.
$BR
$BR
Note that \(\vec{u}_{1}\), \(\vec{u}_{2}\) and \(\vec{u}_{3}\) are orthogonal.
$BR
$BR
\(\operatorname{proj}_W \vec{v}=\) \{ans_rule(10)\} \(\vec{u}_{1}+\) \{ans_rule(10)\} \(\vec{u}_{2}+\) \{ans_rule(10)\} \(\vec{u}_{3}\)

END_TEXT

ANS(num_cmp($c1));
ANS(num_cmp($c2));
ANS(num_cmp($c3));

ENDDOCUMENT();       # This should be the last executable line in the problem.