## KEYWORDS('linear algebra','transition matrix'')

DOCUMENT();
loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "parserMultiAnswer.pl",
  "AnswerFormatHelp.pl",
  "PGchoicemacros.pl",
  "PGcourse.pl"
);
$showPartialCorrectAnswers = 1;
TEXT(beginproblem()); 

Context('Matrix');

{
$a = non_zero_random(-4,4,1);
$B1 = Matrix([[$a,0],[0,-$a]]);
$b = non_zero_random(-4,4,1);
$B2 = Matrix([[0,0],[$b,0]]);
redo if ($a==1 && $b==1);
redo if (abs($a)==abs($b));
}
{
$c = non_zero_random(-5,5,1);
$d = non_zero_random(-5,5,1);
$C1 = Matrix([[$c,0],[$d,-$c]]);
$e = non_zero_random(-5,5,1);
$f = non_zero_random(-5,5,1);
$C2 = Matrix([[$e,0],[$f,-$e]]);
redo if ($c*$f==$e*$d);
}

$C2B = Matrix([[$c/$a,$e/$a],[$d/$b,$f/$b]]);

Context()->texStrings;
BEGIN_TEXT
Consider the two ordered bases
\[ \mathcal{B} = \left$LBRACE $B1, $B2 \right$RBRACE, \]
\[ \mathcal{C} = \left$LBRACE $C1, $C2 \right$RBRACE, \] 
for the vector space \( V \) of lower triangular \( 2\times 2\) matrices
with zero trace.
$BR
Compute the transition matrix from \( \mathcal{C} \) to \( \mathcal{B} \).
$BR
\( P_{\mathcal{C}\to\mathcal{B}} = \) \{ $C2B->ans_array(3) \}
END_TEXT
Context()->normalStrings;
ANS( $C2B->cmp() );

COMMENT('Easier.');

ENDDOCUMENT();

