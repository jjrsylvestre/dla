## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS ('linear algebra','matrix adjoints','hermitian')

## DBsubject('Linear Algebra')
## DBchapter('Adjoints')
## DBsection('Matrix Adjoints')
## Date('2013/03/29')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Campus')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox, display_matrix_mm
  "PGchoicemacros.pl",
#  "answerHints.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context("Complex");

$cmc = new_checkbox_multiple_choice();


##############################################
# build the non-Hermitian matrices
@no = ();

# 2x2 with one complex on diagonal
$z[1] = Complex(non_zero_random(-9,9),non_zero_random(-9,9));
$z[2] = Complex(0,non_zero_random(-9,9));
$z[3] = Complex(non_zero_random(-9,9),0);
($z[2],$z[3]) = ($z[3],$z[2]) if (random(0,1));
$Z = Matrix([ [$z[2],$z[1]], [$z[1]->conj,$z[3]] ]);
push(@no, $Z->TeX);

# 2x2 symmetric
$z[1] = Complex(non_zero_random(-9,9),non_zero_random(-9,9));
$Z = Matrix([ [random(-9,9),$z[1]], [$z[1],random(-9,9)] ]);
push(@no, $Z->TeX);

# 3x3 with one entry symmetric instead of conj-symm
$j = random(1,3);
foreach $i (1..3) {
	$z[$i] = Complex(random(-9,9),non_zero_random(-9,9));
	if ($i == $j) {
		$w[$j] = $z[$j];
	} else {
		$w[$i] = conj($z[$i])
	}
}
$Z = Matrix([ [0,$z[1],$z[2]], [$w[1],0,$z[3]], [$w[2],$w[3],0] ]);
push(@no, $Z->TeX);


##############################################
# build the Hermitian matrices
@yes = ();

# 2x2
$z[1] = Complex(random(-9,9),non_zero_random(-9,9));
$Z = Matrix([ [random(-9,9),$z[1]], [$z[1]->conj,random(-9,9)] ]);
push(@yes, $Z->TeX);

# 2x2 real symmetric
$a = non_zero_random(-9,9);
$Z = Matrix([ [random(-9,9),$a], [$a,random(-9,9)] ]);
push(@yes, $Z->TeX);

# 3x3 with all zeros on the diagonal
$z[1] = Complex(random(-9,9),random(-9,9));
$z[2] = Complex(random(-9,9),random(-9,9));
$z[3] = Complex(random(-9,9),random(-9,9));
$Z = Matrix([ [0,$z[1],$z[2]], [$z[1]->conj,0,$z[3]], [$z[2]->conj,$z[3]->conj,0] ]);
push(@yes, $Z->TeX);


##############################################
$cmc -> qa(
	"Which of the following matrices are Hermitian?", 
	"\($yes[0]\)$BR",
	"\($yes[1]\)$BR",
	"\($yes[2]\)$BR",
);

$cmc-> extra(
	"\($no[0]\)$BR",
	"\($no[1]\)$BR",
	"\($no[2]\)$BR",
);

Context()->texStrings;
BEGIN_TEXT
\{ $cmc -> print_q \}
$BR
\{ $cmc -> print_a \}
END_TEXT
Context()->normalStrings;

ANS(checkbox_cmp( $cmc->correct_ans )   ) ;
               

ENDDOCUMENT();       # This should be the last executable line in the problem.

