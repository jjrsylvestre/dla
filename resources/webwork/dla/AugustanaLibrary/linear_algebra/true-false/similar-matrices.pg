## Problem1('')

DOCUMENT();      
loadMacros("PGbasicmacros.pl",
           "PGchoicemacros.pl",
           "PGanswermacros.pl",

);
TEXT(beginproblem(), $BR,$BBOLD, "Similar Matrices", $EBOLD, $BR,$BR);

# True false questions are a special case of a "select list"
# Make a new select list
$tf = new_select_list();
# $tf now "contains" the select list object.
# Insert some  questions and whether or not they are true.

$k = random(2,10000);

$tf -> qa ( # each entry has to end with a comma
"If \(A\) and \(P\) are \(n\times n\) matrices, with \(P\) invertible, and \(\mathcal{B} = \{\mathbf{p}_1,\mathbf{p}_2,\dotsc,\mathbf{p}_n\}\) is the basis of \(\mathbb{R}^n\) formed by the columns of \(P\), then the \(j^{\mathrm{th}}\) column of \(P^{-1}AP\) is the coordinate vector \([A\mathbf{p}_j]_{\mathcal{B}}\).",
"T",
"Similar matrices have the same eigenvalues with the same algebraic multiplicities.",
"T",
"Two square matrices of the same size that have the same eigenvalues with the same algebraic multiplicities must be similar.",
"F",
"If \(A\) and \(B\) are similar, then so are \(A^{$k}\) and \(B^{$k}\).",
"T",
"If \(A\) is similar to a diagonal matrix, then the characteristic polynomial of \(A\) can be completely factored into linear factors (ie. has no irreducible quadratic factors).",
"T",
);

# Choose five of the question and answer pairs at random.
$tf ->choose(5);

# Now print the text using $ml->print_q for the questions
# and $ml->print_a to print the answers.

BEGIN_TEXT
$PAR

Enter T or F depending on whether the statement is true or false.
(You must enter T or F -- True and False will not work.)

$PAR

$BBOLD Assume that all matrices in the following statements are square and have real entries. $EBOLD

$PAR

\{ $tf-> print_q \}

$PAR

END_TEXT

# Enter the correct answers to be checked against the answers to the students.

install_problem_grader(~~&std_problem_grader);
# Since this is a true questions, we do not usually wish to tell students which
# parts of the matching question have been answered correctly and which are
# incorrect.  That is too easy.  To accomplish this we set the following flag to
# zero.
$showPartialCorrectAnswers = 0;

ANS(str_cmp( $tf->ra_correct_ans )   ) ;

ENDDOCUMENT();        # This should be the last executable line in the problem.
