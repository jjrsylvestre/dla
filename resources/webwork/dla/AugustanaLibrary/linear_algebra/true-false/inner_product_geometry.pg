DOCUMENT();      
loadMacros("PGbasicmacros.pl",
           "PGchoicemacros.pl",
           "PGanswermacros.pl",

);
TEXT(beginproblem(), $BR,$BBOLD, "Geometry in Inner Product Spaces", $EBOLD, $BR,$BR);

# True false questions are a special case of a "select list"
# Make a new select list
$tf = new_select_list();
# $tf now "contains" the select list object.
# Insert some  questions and whether or not they are true.

$tf -> qa ( # each entry has to end with a comma
"If \(\mathbf{u},\mathbf{v},\mathbf{w}\) are vectors in \(V\) such that \(\mathbf{u}\) is orthogonal to \(\mathbf{v}\) and \(\mathbf{v}\) is orthogonal to \(\mathbf{w}\), then \(\mathbf{u}\) is orthogonal \(\mathbf{w}\).",
"F",
"If \(\mathbf{w},\mathbf{u}_1,\mathbf{u}_2,\dotsc,\mathbf{u}_m\) are vectors in \(V\) with \(\mathbf{w}\) orthogonal to each vector \(\mathbf{u}_j\), then \(\mathbf{w}\) lies in \((\operatorname{Span}\{\mathbf{u}_1,\mathbf{u}_2,\dotsc,\mathbf{u}_m\})^\perp\).",
"T",
"If \(U\) and \(W\) are subspaces of \(V\) such that \(U\) is a subspace of \(W\), then \(U^\perp\) is a subspace of \(W^\perp\).",
"F",
"If nonzero \(\mathbf{u},\mathbf{v} \in V\) satisfy \(\lVert \mathbf{u}+\mathbf{v} \rVert = \lVert \mathbf{u} \rVert + \lVert \mathbf{v} \rVert\), then \(\mathbf{u} \in \operatorname{Span} \{\mathbf{v}\}\).",
"T",
"If \(V\) is finite dimensional, and \(U\) is a subspace of \(V\), then \(U,U^\perp\) are a complete set of independent subspaces of \(V\).",
"T",
);   

# Choose five of the question and answer pairs at random.
$tf ->choose(5);

# Now print the text using $ml->print_q for the questions
# and $ml->print_a to print the answers.

BEGIN_TEXT
$PAR

Enter T or F depending on whether the statement is true or false.
(You must enter T or F -- True and False will not work.)$BR

$PAR

$BBOLD In the following, assume that \(V\) is an abstract inner product space (unless otherwise stated). $EBOLD

$PAR

\{ $tf-> print_q \}

$PAR

END_TEXT

# Enter the correct answers to be checked against the answers to the students.

install_problem_grader(~~&std_problem_grader);
# Since this is a true questions, we do not usually wish to tell students which
# parts of the matching question have been answered correctly and which are
# incorrect.  That is too easy.  To accomplish this we set the following flag to
# zero.
$showPartialCorrectAnswers = 0;

ANS(str_cmp( $tf->ra_correct_ans )   ) ;

ENDDOCUMENT();        # This should be the last executable line in the problem.
