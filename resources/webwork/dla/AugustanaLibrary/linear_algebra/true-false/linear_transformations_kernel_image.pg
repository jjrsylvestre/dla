## DBsubject('Linear Algebra')
## DBchapter('AUMAT220 Ch 8')
## DBsection('AUMAT220 S 2')
## Date('3/3/11')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Faculty')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

DOCUMENT();      
loadMacros("PGbasicmacros.pl",
           "PGchoicemacros.pl",
           "PGanswermacros.pl",

);
TEXT(beginproblem(), $BR,$BBOLD, "Kernel and Image", $EBOLD, $BR,$BR);

# True false questions are a special case of a "select list"
# Make a new select list
$tf = new_select_list();
# $tf now "contains" the select list object.
# Insert some  questions and whether or not they are true.

$tf -> qa ( # each entry has to end with a comma
"If \(T\colon \mathbb{R}^7 \to \mathbb{M}_{22}\) is a linear transformation, where \(\mathbb{M}_{22}\) is the space of \(2\times 2\) matrices with real entries, then \(\operatorname{nullity}(T) = 3\).",
"F",
"If \(T\colon V \to W\) is a linear transformation, then \(\ker(T)\) is a subspace of \(W\).",
"F",
"If \(A\) is an \(m\times n\) matrix and \(T_A\colon \mathbb{R}^n \to \mathbb{R}^m\) is the corresponding linear transformation defined by \(T_A(X)=AX\), then \(\ker(T) = \operatorname{nullspace}(A)\).",
"T",
"If \(T\colon V \to W\) is a linear transformation and \(\mathbf{u},\mathbf{v} \in V\) such that \(T(\mathbf{u}) = T(\mathbf{v})\), then \(\mathbf{u}-\mathbf{v} \in \ker(T)\).",
"T",
"If \(T\colon V \to W\) is a linear transformation such that \(R(T) = W\), then \(\ker(T) = \{\mathbf{0}_V\}\), where \(\mathbf{0}_V\) is the zero vector in \(V\).",
"F",
);   

# Choose five of the question and answer pairs at random.
$tf ->choose(5);

# Now print the text using $ml->print_q for the questions
# and $ml->print_a to print the answers.

BEGIN_TEXT
$PAR

Enter T or F depending on whether the statement is true or false.
(You must enter T or F -- True and False will not work.)$BR

$PAR

$BBOLD In the following, assume that \(V\) and \(W\) are finite dimensional abstract vector spaces, unless otherwise stated. $EBOLD

$PAR

\{ $tf-> print_q \}

$PAR

END_TEXT

# Enter the correct answers to be checked against the answers to the students.

install_problem_grader(~~&std_problem_grader);
# Since this is a true questions, we do not usually wish to tell students which
# parts of the matching question have been answered correctly and which are
# incorrect.  That is too easy.  To accomplish this we set the following flag to
# zero.
$showPartialCorrectAnswers = 0;

ANS(str_cmp( $tf->ra_correct_ans )   ) ;

ENDDOCUMENT();        # This should be the last executable line in the problem.
