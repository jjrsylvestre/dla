## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS ('linear algebra','vector space','linear transformation','orthogonal projection')
## Tagged by cmd6a 5/3/06

## DBsubject('Linear Algebra')
## DBchapter('Vector Spaces')
## DBsection('Linear Transformations')
## Date('')
## Author('')
## Institution('Rochester')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

## Based on
## NationalProblemLibrary/Rochester/setLinearAlgebra14TransfOfRn/ur_la_14_20.pg
## NationalProblemLibrary/Rochester/setLinearAlgebra14TransfOfRn/ur_la_14_21.pg

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox
  "PGchoicemacros.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context("Matrix");

$v[0] = random(1,6,1);
$v[1] = random(1,6,2);
$v2 += 1 if ($v2 == $v1);

$V = Vector(@v);

$std[0] = Vector(1,0);
$std[1] = Vector(0,1);

$ans_col_A[$_] = ($std[$_] . $V) * $V / ($V . $V) for (0..1);

$A = Matrix(@ans_col_A)->transpose;

Context()->texStrings;
BEGIN_TEXT
Let \(L\) be the line in \( {\mathbb R} ^2 \) that consists of all scalar multiples of the vector \($V\).
$PAR
$BBOLD (a) $EBOLD $BR
Find the matrix \(A\) of the linear operator \(T\) on \( {\mathbb R} ^2 \) defined by \(T(\mathbf{x}) = \operatorname{proj}_L \mathbf{x}\).
$BR
\{ mbox([ '\(A=\)', $A->ans_array, '.' ]) \}
END_TEXT
Context()->normalStrings;

ANS($A->cmp);


# answers for reflection will be 2*p - std, where p = answer for projection
$ans_col_B[$_] = 2 * $ans_col_A[$_] - $std[$_] for (0..1);

$B = Matrix(@ans_col_B)->transpose;

Context()->texStrings;
BEGIN_TEXT
$PAR
$BBOLD (b) $EBOLD $BR
Find the matrix \(B\) of the linear operator \(S\) on \( {\mathbb R} ^2 \) that sends a vector \(\mathbf{x}\) to its reflection in \(L\).
$BR
\{ mbox([ '\(B=\)', $B->ans_array, '.' ]) \}
END_TEXT
Context()->normalStrings;

ANS($B->cmp);

ENDDOCUMENT();       # This should be the last executable line in the problem.
