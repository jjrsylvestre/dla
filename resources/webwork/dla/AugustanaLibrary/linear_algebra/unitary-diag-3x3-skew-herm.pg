## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS('inner product spaces','complex matrices','unitary diagonalization')

## DBsubject('Linear Algebra')
## DBchapter('Inner Product Spaces')
## DBsection('Unitary Diagonalization')
## Date('2015/03/28')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Campus')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PG.pl",
  "PGbasicmacros.pl",
  "PGchoicemacros.pl",
  "PGanswermacros.pl",
  "PGmatrixmacros.pl",
  "parserMultiAnswer.pl",
  "MathObjects.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context("Complex");
Context()->parens->set("<" => {type => "Vector", close => ">"});

$n = 3;

$s = random(1,4);
$ss = $s + 1;
$t = 2*$s;

$eig_im[1] = 1 + $t;
$eig_im[2] = 1 - $t;

# Unnormalized eigenvecs
# Note: p2, p3 are already orthogonal
# eig2
$p[1] = ColumnVector(
	Compute("-i"),
	Compute("-sqrt(2)"),
	Compute("1"),
);
$pconj[1] = ColumnVector(
	Compute("i"),
	Compute("-sqrt(2)"),
	Compute("1"),
);
$normsq[1] = Compute("4");
$norm[1] = Compute("2");
# eig1 vec 1, norm = sqrt(2)
$p[2] = ColumnVector(
	Compute("i"),
	Compute("0"),
	Compute("1"),
);
$pconj[2] = ColumnVector(
	Compute("-i"),
	Compute("0"),
	Compute("1"),
);
$normsq[2] = Compute("2");
$norm[2] = Compute("sqrt(2)");
# eig1 vec 2, norm = 2
$p[3] = ColumnVector(
	Compute("-i"),
	Compute("sqrt(2)"),
	Compute("1"),
);
$pconj[3] = ColumnVector(
	Compute("i"),
	Compute("sqrt(2)"),
	Compute("1"),
);
$normsq[3] = Compute("4");
$norm[3] = Compute("2");

# normalized eigenvecs
foreach $i (1..3) { $q[$i] = $p[$i] / $norm[$i]; }

########################################
# Answer checkers
########################################

sub chk_unit {
	my $vec = shift;
	return ( ColumnVector( map(conj($_),$vec->value) ) . $vec - Complex(1,0) )->isZero;
}

sub chk_1vec {
	my ( $correct, $student, $ansHash ) = @_;
	# check parallel by projecting student answer onto $eigvec
	# if parallel this projection should be equal to the original student answer
	my $student_proj_diff = $normsq[1] * $student - ($pconj[1] . $student) * $p[1];
	return 0 if (! $student_proj_diff->isZero);
	# check unit vector
	return chk_unit($student);
}

sub chk_2vecs {
	my ( $correct, $student, $ansHash ) = @_;
	my ( $stu1, $stu2 ) = @{$student};
	# check parallel by projecting student answers onto plane spanned by $eigvecs
	# if parallel each projection should be equal to the original student answer
	foreach $stu_vec ($stu1,$stu2) {
		my $student_proj_diff
		  = $normsq[2] * $normsq[3] * $stu_vec
		  - $normsq[3] * ($pconj[2] . $stu_vec) * $p[2]
		  - $normsq[2] * ($pconj[3] . $stu_vec) * $p[3];
		return 0 if (! $student_proj_diff->isZero);
	}
	# check student answers are orthogonal to each other
	return 0 if (! ( ColumnVector( map(conj($_),$stu1->value) ) . $stu2 )->isZero);
	# check unit vector
	return ( chk_unit($stu1) && chk_unit($stu2) );
}

$multians = MultiAnswer($q[2],$q[3])->with(
	singleResult => 1,
	separator => ', ',
	tex_separator => ', ',
	allowBlankAnswers=>0,
	checker => ~~&chk_2vecs
);

########################################


$ssqrt = "\sqrt{2}";
$ssqrt = "$s " . $ssqrt if ($s > 1);

Context()->texStrings;
BEGIN_TEXT
$BBOLD $BITALIC Preamble: $EITALIC $EBOLD A square matrix is called $BITALIC skew-Hermitian $EITALIC if \(H^{\ast} = -H\). It is easy to check that skew-Hermitian matrices are normal, and so are unitarily diagonalizable. Furthermore, if \(H\) is skew-Hermitian, then the matrix \(iH\) is Hermitian.
$PAR
\{mbox([
	'Consider the skew-Hermitian matrix \(H=\)',
	display_matrix([
		['\($ss i\)', '\($ssqrt\)', '\(-$s\)'],
		['\(- $ssqrt\)', '\(i\)', '\($ssqrt i\)'],
		['\($s\)', '\($ssqrt i\)', '\($ss i\)'] ]),
	'.'
]) \}
$PAR
The corresponding Hermitian matrix \(iH\) has two distinct (real) eigenvalues \(\mu_1 < \mu_2 \), where
$PAR
\{ mbox([
	'\(\mu_1 =\)', ans_rule(5),
	', $SPACE$SPACE \(\mu_2 =\)', ans_rule(5),
	'.'
]) \}
END_TEXT
Context()->normalStrings;
ANS(Real(-$eig_im[1])->cmp);
ANS(Real(-$eig_im[2])->cmp);

Context()->texStrings;
BEGIN_TEXT
$PAR
From the knowledge that \(\mu_1\) is an eigenvalue of \(iH\), we may conclude that \(\lambda_1 = \) \{ ans_rule(5) \} is an eigenvalue of \(H\).
$PAR
From the knowledge that \(\mu_2\) is an eigenvalue of \(iH\), we may conclude that \(\lambda_2 = \) \{ ans_rule(5) \} is an eigenvalue of \(H\).
END_TEXT
Context()->normalStrings;
ANS(Complex(0,$eig_im[1])->cmp);
ANS(Complex(0,$eig_im[2])->cmp);

Context()->texStrings;
BEGIN_TEXT
$PAR
To achieve \( U^{\ast} HU =
  \{ display_matrix_mm([['\lambda_1','',''],['','\lambda_1',''],['','','\lambda_2']]) \}
\)
we could use \(U =
  \{display_matrix_mm([['\mathbf{u}_1','\mathbf{u}_2','\mathbf{u}_3']])\}
\),
\{mbox(
  'where \(\mathbf{u}_1 = \)',
  $multians->ans_array(20),
  ', \(\mathbf{u}_2 = \)',
  $multians->ans_array(20),
  ' and \(\mathbf{u}_3 = \)',
  $q[1]->ans_array(20),
  '.'
)\}
END_TEXT
Context()->normalStrings;

ANS($multians->cmp());
ANS($q[1]->cmp(showCoordinateHints => 0,checker=> ~~&chk_1vec));


ENDDOCUMENT();       # This should be the last executable line in the problem.
