## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS('matrix', 'eigenvalues' 'generalized eigenspaces')

## DBsubject(Linear algebra)
## DBchapter(Matrix forms)
## DBsection(Block matrices)
## Date(Feb 2015)
## Institution(University of Alberta, Augustana Campus)
## Author(J. Sylvestre)


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox
#  "answerHints.pl",     # answer post-filter to give student messages about his/her answer
);


TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context("Matrix");

$n = 12;

$eigval = random(2,5)*random(-1,1,2);

foreach $i (0..$n-1) {
	foreach $j (0..$n-1) { 
		$s[$i][$j] = 0;
	}
	$s[$i][$i] = $eigval;
}

# decide on the blocks
$nblocks = 0;
$sum_block_size = 0;
$max_block_range = 7;
$min_block_range = 5;
@blocks=();
do {
	$nblocks++;
	$temp_block_size = random($min_block_range,$max_block_range);
	# put new block size into effect
	push(@blocks,$temp_block_size);
	foreach $i ($sum_block_size+1..$sum_block_size+$temp_block_size-1) { # the -1 is because the last row doesn't need a 1 on the superdiagonal
		$s[$i-1][$i] = 1; # perl array indices start at 0
	}
	push(@block_ranks,$temp_block_size-1);
	# set up for computation of next block size
	$sum_block_size += $temp_block_size;
	$max_block_range = $temp_block_size;
	$max_block_range = $n - $sum_block_size if ($max_block_range > $n - $sum_block_size);
	$min_block_range = $max_block_range - 2;
	$min_block_range = 1 if ($min_block_range < 1);
} until ($sum_block_size == $n);

# Form $A by conjugating $S by random elementary matrices of det +/- 1.
# Stop when $A has at most $maxzeros off-diagonal zeros
$maxzeros = 50;
$nzeros = $n*($n-1); # actually, the initial $nzeros is somewhere (strictly) between $n*($n-2)+1 and $n*($n-1)
$count = 0;
while ( ($nzeros > $maxzeros) && ($count < 100) ) {
	$i = random(0,$n-1);
	do { $j = random(0,$n-1); } until ($j != $i);
	if (random(0,1)) {
		# conjugate by elementary matrix of the 
		# "add mult of one row to another" variety
		$m = non_zero_random(-5,5);
		foreach $k (0..$n-1) {
			$s[$i][$k] += $m * $s[$j][$k];
		}
		foreach $k (0..$n-1) {
			$s[$k][$j] -= $m * $s[$k][$i];
		}
	} else {
		# conjugate by elementary matrix of the
		# "swap two rows" variety
		($s[$i],$s[$j]) = ($s[$j],$s[$i]);
		foreach $k (0..$n-1) {
			($s[$k][$i],$s[$k][$j]) = ($s[$k][$j],$s[$k][$i]);
		}
	}
	$count++;
	$nzeros = 0;
	foreach $i (0..$n-1) {
		foreach $j (0..$n-1) {
			$nzeros++ if ( ($i != $j) && ($s[$i][$j] == 0) );
		}
	}
}

warn "There seems to be a problem generating a random matrix for you --- please contact your instructor" if ($count == 100);

$A = Matrix(@s);

$sage_str = "A = matrix(" . $A->string . ");";

Context()->texStrings;
BEGIN_TEXT

The matrix \(A\) below has a single eigenvalue \(\lambda = $eigval\) of algebraic multiplicity $n.
\[ A = $A \]
If you are using the Sage mathematics program to perform the calculations in this question,
here is a ready-made input line that you can copy and paste into Sage. $BR
$sage_str
$PAR
In each line below, determine the rank of the given power of \($eigval I - A\), and use that answer to determine the dimension of the corresponding generalized eigenspace.
$PAR

END_TEXT
Context()->normalStrings;

BEGIN_TEXT
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{1} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{1}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{2} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{2}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{3} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{3}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{4} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{4}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{5} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{5}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{6} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{6}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{7} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{7}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{8} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{8}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{9} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{9}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{10} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{10}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{11} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{11}(A) =\)', ans_rule(5)
)\}
$BR
\{mbox(
	'\(\operatorname{rank} ($eigval I - A)^{12} =\)', ans_rule(5),
	'$SPACE$SPACE$SPACE$SPACE \(\dim E_{$eigval}^{12}(A) =\)', ans_rule(5)
)\}
END_TEXT

foreach $exponent (1..$n) {
	$rank = 0;
	foreach (@blocks) {
		$b_rank = $_ - $exponent;
		$b_rank = 0 if ($b_rank < 0);
		$rank += $b_rank;
	}
	ANS(Compute("$rank")->cmp);
	ANS(Compute("$n-$rank")->cmp);
}


ENDDOCUMENT();       # This should be the last executable line in the problem.
