## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS('matrix forms','matrices','nilpotent triangular form')

## DBsubject('Linear Algebra')
## DBchapter('Matrices')
## DBsection('Matrix Forms')
## Date('Feb 2015')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Campus')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

## MATHOBJECT VERSION

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox, display_matrix
#  "answerHints.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 0;

Context("Matrix");

$n = 8;

foreach $i (0..$n-1) {
	foreach $j (0..$n-1) {
		$s[$i][$j] = 0;
	}
}
# decide on the blocks
$sum_block_size = 0;
$max_block_range = $n/2;
$min_block_range = $max_block_range-1;
@blocks=();
do {
	$temp_block_size = random($min_block_range,$max_block_range);
	# put new block size into effect
	push(@blocks,$temp_block_size);
	$s[$_][$_-1] = 1 for ($sum_block_size+1..$sum_block_size+$temp_block_size-1);
	# ^^^ the +1 on $sum_block_size is because the first row doesn't need a 1 on the subdiagonal
	# set up for computation of next block size
	$sum_block_size += $temp_block_size;
	$max_block_range = $temp_block_size;
	$max_block_range = $n - $sum_block_size if ($max_block_range > $n - $sum_block_size);
	$min_block_range = $max_block_range - 2;
	$min_block_range = 1 if ($min_block_range < 1);
} until ($sum_block_size == $n);

$S = Matrix(@s);

# now compute ranks of powers of $S based on blocks
@ranks = ();
foreach $exponent (1..$n) {
	my $rank = 0;
	foreach (@blocks) {
		my $b_rank = $_ - $exponent;
		$b_rank = 0 if ($b_rank < 0);
		$rank += $b_rank;
	}
	push(@ranks,$rank);
}

# using these instead of ->inverse to avoid divisions
# which can cause round-off errors for zero entries
sub unimodular_upper_tri_inverse {
	my @u = (shift)->value;
	my @I = Value::Matrix->I($n)->value;
	foreach my $d (1..$n) {
		$dd = $n - $d;
		foreach my $i (0..$dd-1) {
			foreach my $j ($n-$d..$n-1) {
				$I[$i][$j] -= $u[$i][$dd] * $I[$dd][$j];
			}
		}
	}
	return Matrix(@I);
}
sub unimodular_lower_tri_inverse {
	return (unimodular_upper_tri_inverse(shift->transpose))->transpose;
}

# Form $A by conjugating $S by matrices of det +/- 1.
# First an upper triangular, then a lower triangular, then a permutation matrix
$nperms = $n;
$randrange = 1;
$skiprange = 1;
$upper_skipcount = 0;
$upper_skip = random(0,$skiprange);
$lower_skipcount = 0;
$lower_skip = random(0,$skiprange);
foreach $i (0..$n-1) {
	foreach $j (0..$i-1) {
		$upper[$i][$j] = 0;
		$lower[$j][$i] = 0;
	}
	$upper[$i][$i] = 1;
	$lower[$i][$i] = 1;
	foreach $j ($i+1..$n-1) {
		if ($upper_skipcount == $upper_skip) {
			$upper[$i][$j] = random(0,$randrange) * random(-1,1,2);
			$upper_skipcount = 0;
			$upper_skip = random(0,$skiprange);
		} else {
			$upper[$i][$j] = 0;
			$upper_skipcount++;
		}
		if ($lower_skipcount == $lower_skip) {
			$lower[$j][$i] = random(0,$randrange) * random(-1,1,2);
			$lower_skipcount = 0;
			$lower_skip = random(0,$skiprange);
		} else {
			$lower[$j][$i] = 0;
			$lower_skipcount++;
		}
	}
}
$Upper = Matrix(@upper);
$Lower = Matrix(@lower);
@perm = Value::Matrix->I($n)->value;
@perm_tracking = ();
foreach (1..$nperms) {
	$i = random(0,$n-1);
	do { $j = random(0,$n-1); } until ($j != $i);
	($perm[$i],$perm[$j]) = ($perm[$j],$perm[$i]);
	push(@perm_tracking,$i,$j);
}
$Perm = Matrix(@perm);
@perm = Value::Matrix->I($n)->value;
foreach $k (0..$nperms-1) {
	$j = pop @perm_tracking;
	$i = pop @perm_tracking;
	($perm[$i],$perm[$j]) = ($perm[$j],$perm[$i]);
}
$PermI = Matrix(@perm);

$A = $Perm * $Lower * $Upper * $S
     * unimodular_upper_tri_inverse($Upper) * unimodular_lower_tri_inverse($Lower) * $PermI;

$sage_str = "A = matrix(" . $A->string . ");";

Context()->texStrings;
BEGIN_TEXT
The \($n \times $n\) matrix \(A=$A\) is nilpotent.
$PAR
If you are using the Sage mathematics program to help you handle this matrix,
here is a ready made input line that you can copy-and-paste into Sage.
$PAR
$sage_str
$PAR
Determine the ranks of the powers of \(A\), as well as the nullity of \(A\).
$PAR
$PAR
\{mbox(['\(\operatorname{rank} A =\)', ans_rule(5), '$SPACE$SPACE$SPACE$SPACE\(\operatorname{nullity} A =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^2 =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^3 =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^4 =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^5 =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^6 =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^7 =\)', ans_rule(5)])\}
\{mbox(['\(\operatorname{rank} A^8 =\)', ans_rule(5)])\}
Now use the above information to determine the nilpotent triangular form of \(A\).
$PAR
\{mbox([
  '\(A\) is similar to ',
	display_matrix([
	  [0,0,0,0,0,0,0,0],
	  [ans_rule(2),0,0,0,0,0,0,0],
	  [0,ans_rule(2),0,0,0,0,0,0],
	  [0,0,ans_rule(2),0,0,0,0,0],
	  [0,0,0,ans_rule(2),0,0,0,0],
	  [0,0,0,0,ans_rule(2),0,0,0],
	  [0,0,0,0,0,ans_rule(2),0,0],
	  [0,0,0,0,0,0,ans_rule(2),0],
	]),
])\}
$PAR
$BITALIC NOTE: $EITALIC The answer boxes run down the subdiagonal.
END_TEXT
Context()->normalStrings;

ANS(Compute("$ranks[0]")->cmp);  ANS(Compute("$n-$ranks[0]")->cmp);
ANS(Compute("$ranks[1]")->cmp);
ANS(Compute("$ranks[2]")->cmp);
ANS(Compute("$ranks[3]")->cmp);
ANS(Compute("$ranks[4]")->cmp);
ANS(Compute("$ranks[5]")->cmp);
ANS(Compute("$ranks[6]")->cmp);
ANS(Compute("$ranks[7]")->cmp);

ANS($S->element(2,1)->cmp);
ANS($S->element(3,2)->cmp);
ANS($S->element(4,3)->cmp);
ANS($S->element(5,4)->cmp);
ANS($S->element(6,5)->cmp);
ANS($S->element(7,6)->cmp);
ANS($S->element(8,7)->cmp);

ENDDOCUMENT();       # This should be the last executable line in the problem.









