## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS('matrix forms','matrices','cyclic subspaces')

## DBsubject('Linear Algebra')
## DBchapter('Matrices')
## DBsection('Matrix Forms')
## Date('Feb 2015')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Campus')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox
#  "answerHints.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 0;

Context("Matrix");

$n = 6;
$d1 = random(2,4);
$d2 = $n - $d1;

foreach $i (0..$d1-1) {
	$s[$i][$d1-1] = random(-2,2);
	$s[$i][$i-1] = 1 if ($i > 0);
	foreach $j (0..$i-2,$i..$d1-2,$d1..$n-1) { $s[$i][$j] = 0; }
}
foreach $i ($d1..$n-1) {
	$s[$i][$n-1] = random(-2,2);
	$s[$i][$i-1] = ($i > $d1) ? 1 : 0;
	foreach $j (0..$i-2,$i..$n-2) { $s[$i][$j] = 0; }
}

$S = Matrix(@s);

# using these instead of ->inverse to avoid divisions
# which can cause round-off errors for zero entries
sub unimodular_upper_tri_inverse {
	my @u = (shift)->value;
	my @I = Value::Matrix->I($n)->value;
	foreach my $d (1..$n) {
		$dd = $n - $d;
		foreach my $i (0..$dd-1) {
			foreach my $j ($n-$d..$n-1) {
				$I[$i][$j] -= $u[$i][$dd] * $I[$dd][$j];
			}
		}
	}
	return Matrix(@I);
}
sub unimodular_lower_tri_inverse {
	return (unimodular_upper_tri_inverse(shift->transpose))->transpose;
}

# Form $A by conjugating $S by matrices of det +/- 1.
# First an upper triangular, then a lower triangular, then a permutation matrix
$nperms = $n;
$randrange = 1;
foreach $i (0..$n-1) {
	foreach $j (0..$n-1) {
		if ($i == $j) {
			$upper[$i][$j] = 1;
		} elsif ($i < $j) {
			$upper[$i][$j] = random(-$randrange,$randrange);
		} else {
			$upper[$i][$j] = 0;
		}
	}
}
$Upper = Matrix(@upper);
foreach $i (0..$n-1) {
	foreach $j (0..$n-1) {
		if ($i == $j) {
			$lower[$i][$j] = 1;
		} elsif ($i > $j) {
			$lower[$i][$j] = random(-$randrange,$randrange);
		} else {
			$lower[$i][$j] = 0;
		}
	}
}
$Lower = Matrix(@lower);
@perm = Value::Matrix->I($n)->value;
@perm_tracking = ();
foreach (1..$nperms) {
	$i = random(0,$n-1);
	do { $j = random(0,$n-1); } until ($j != $i);
	($perm[$i],$perm[$j]) = ($perm[$j],$perm[$i]);
	push(@perm_tracking,$i,$j);
}
$Perm = Matrix(@perm);
@perm = Value::Matrix->I($n)->value;
foreach $k (0..$nperms-1) {
	$j = pop @perm_tracking;
	$i = pop @perm_tracking;
	($perm[$i],$perm[$j]) = ($perm[$j],$perm[$i]);
}
$PermI = Matrix(@perm);


$P = $Perm * $Lower * $Upper;
$A = $P * $S * unimodular_upper_tri_inverse($Upper) * unimodular_lower_tri_inverse($Lower) * $PermI;
$u = $P->column(1);
$w = $P->column($d1+1);

$sage_str_A = "A = matrix(" . $A->string . ");";
$sage_str_u = "u = matrix(" . $u->string . ");";
$sage_str_w = "w = matrix(" . $w->string . ");";

Context()->texStrings;
BEGIN_TEXT
Let \( A = $A \), \( \mathbf{u} = $u \), \( \mathbf{w} = $w \).
$PAR
If you are using the Sage mathematics program to perform the calculations in this question,
here are some ready-made input lines that you can copy and paste into Sage. $BR
$sage_str_A $BR
$sage_str_u $BR
$sage_str_w
$PAR
Compute the $BITALIC smallest $EITALIC exponent \(k\) so that the set \(\lbrace \mathbf{u}, A\mathbf{u}, A^2\mathbf{u}, \dotsc, A^k \mathbf{u} \rbrace\) is linearly ${BITALIC}dependent${EITALIC}.$BR
$BBOLD Smallest \(k\): $EBOLD \{ans_rule(2)\}. $SPACE$SPACE
${BBOLD}Therefore${EBOLD}, the dimension of the \(A\)-cyclic space generated by \(\mathbf{u}\) is \(d_1 = \) \{ans_rule(2)\}.
$PAR
$BBOLD $BITALIC Calculation Help: $EITALIC $EBOLD
Recall that you can check linear independence of a set of vectors in \(\mathbb{R}^n\) by placing those vectors as columns in matrix and then computing the rank of the matrix.
If you are using Sage, you can join vectors into matrices using the command
column_matrix([v1,v2,...]).
$PAR
Now do the same for \(\mathbf{w}\). Compute the $BITALIC smallest $EITALIC exponent \(k\) so that the set \(\lbrace \mathbf{w}, A\mathbf{w}, A^2\mathbf{w}, \dotsc, A^k \mathbf{w} \rbrace\) is linearly ${BITALIC}dependent${EITALIC}.$BR
$BBOLD Smallest \(k\): $EBOLD \{ans_rule(2)\}. $SPACE$SPACE
${BBOLD}Therefore${EBOLD}, the dimension of the \(A\)-cyclic space generated by \(\mathbf{w}\) is \(d_2 = \) \{ans_rule(2)\}.
$PAR
Let \(P\) be the \($n \times $n\) matrix whose first \(d_1\) columns are \(\mathbf{u},A\mathbf{u},A^2\mathbf{u},\dotsc,A^{d_1-1}\mathbf{u}\), and whose last \(d_2\) columns are \(\mathbf{w},A\mathbf{w},A^2\mathbf{w},\dotsc,A^{d_2-1}\mathbf{w}\). You can check that \(P\) is invertible by checking that its rank is $n. This verifies that the cyclic spaces generated by \(\mathbf{u}\) and \(\mathbf{w}\) are independent, since their bases are independent when combined. Since cyclic spaces are also always invariant, \(P\) puts \(A\) in block-diagonal form.
$PAR
Recall that the \(j^{\text{th}}\) column of \(P^{-1}AP\) contains the coefficients necessary to write \(A\mathbf{p}_j\) as a linear combination of \(\lbrace \mathbf{p}_1,\mathbf{p}_2,\dotsc,\mathbf{p}_{$n}\rbrace\) (where the \(\mathbf{p}_j\) are the columns of \(P\)).
$PAR
Use this fact to determine the form matrix \(P^{-1}AP\). You should be able to fill in 4 of the columns without any computation.
$PAR
\{ mbox( '\(P^{-1}AP=\)', $S->ans_array) \}

END_TEXT
Context()->normalStrings;

ANS(Compute("$d1")->cmp);
ANS(Compute("$d1")->cmp);
ANS(Compute("$d2")->cmp);
ANS(Compute("$d2")->cmp);
ANS($S->cmp);


ENDDOCUMENT();       # This should be the last executable line in the problem.
