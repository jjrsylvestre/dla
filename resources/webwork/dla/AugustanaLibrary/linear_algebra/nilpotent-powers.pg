## Problem1('')

## MATHOBJECT VERSION


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox
  "PGchoicemacros.pl",  # for shuffle
#  "answerHints.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 0;

Context("Matrix");


@nilp_data = ( # [nilp-power,size,supdiag,supdiag,...]
	[2,3,1,0],
	[3,3,1,1],
	[0,3,random(-5,5),random(-5,5)],
	[2,4,1,0,0],
	[3,4,1,1,0],
	[2,4,1,0,1],
	[4,4,1,1,1],
	[0,4,random(-5,5),random(-5,5),random(-5,5)],
);
# nilp-power is min exponent such that A^k = 0
# or is 0 if not nilpotent

# using these instead of ->inverse to avoid divisions
# which can cause round-off errors for zero entries
sub unimodular_upper_tri_inverse {
	my @u = (shift)->value;
	my @I = Value::Matrix->I($n)->value;
	foreach my $d (1..$n) {
		$dd = $n - $d;
		foreach my $i (0..$dd-1) {
			foreach my $j ($n-$d..$n-1) {
				$I[$i][$j] -= $u[$i][$dd] * $I[$dd][$j];
			}
		}
	}
	return Matrix(@I);
}
sub unimodular_lower_tri_inverse {
	return (unimodular_upper_tri_inverse(shift->transpose))->transpose;
}

@matrices = ();
foreach $nd_index (0..$#nilp_data) {
	$n = $nilp_data[$nd_index][1];
	@s = ();
	foreach $i (0..$n-1) {
		foreach $j (0..$n-1) {
			$s[$i][$j] = 0;
		}
	}
	foreach $i (1..$n-1) { $s[$i-1][$i] = $nilp_data[$nd_index][$i+1]; }
	if (! $nilp_data[$nd_index][0]) {
		foreach $i (0..$n-1) { $s[$i][$i] = non_zero_random(-3,3); }
	}

	$S = Matrix(@s);

	# Form $A by conjugating $S by matrices of det +/- 1.
	# First an upper triangular, then a lower triangular, then a permutation matrix
	$nperms = $n;
	$randrange = 1;
	foreach $i (0..$n-1) {
		foreach $j (0..$n-1) {
			if ($i == $j) {
				$upper[$i][$j] = 1;
			} elsif ($i < $j) {
				$upper[$i][$j] = random(-$randrange,$randrange);
			} else {
				$upper[$i][$j] = 0;
			}
		}
	}
	$Upper = Matrix(@upper);
	foreach $i (0..$n-1) {
		foreach $j (0..$n-1) {
			if ($i == $j) {
				$lower[$i][$j] = 1;
			} elsif ($i > $j) {
				$lower[$i][$j] = random(-$randrange,$randrange);
			} else {
				$lower[$i][$j] = 0;
			}
		}
	}
	$Lower = Matrix(@lower);
	@perm = Value::Matrix->I($n)->value;
	@perm_tracking = ();
	foreach (1..$nperms) {
		$i = random(0,$n-1);
		do { $j = random(0,$n-1); } until ($j != $i);
		($perm[$i],$perm[$j]) = ($perm[$j],$perm[$i]);
		push(@perm_tracking,$i,$j);
	}
	$Perm = Matrix(@perm);
	@perm = Value::Matrix->I($n)->value;
	foreach $k (0..$nperms-1) {
		$j = pop @perm_tracking;
		$i = pop @perm_tracking;
		($perm[$i],$perm[$j]) = ($perm[$j],$perm[$i]);
	}
	$PermI = Matrix(@perm);
	push @matrices,
	  $Perm * $Lower * $Upper * $S
	    * unimodular_upper_tri_inverse($Upper) * unimodular_lower_tri_inverse($Lower) * $PermI;
}

@shffld3 = shuffle(3);
@shffld4 = shuffle(5);

Context()->texStrings;
BEGIN_TEXT
Determine which of the following matrices are nilpotent.
$PAR
For those that are nilpotent, enter the smallest positive integer such that \(A^k = \mathbf{0} \).$BR
For those that are not nilpotent, enter 0.
$PAR
\{mbox([ '$BBOLD 1. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld3[0]]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 2. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld3[1]]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 3. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld3[2]]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 4. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld4[0]+3]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 5. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld4[1]+3]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 6. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld4[2]+3]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 7. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld4[3]+3]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
\{mbox([ '$BBOLD 8. $EBOLD $SPACE$SPACE \(A = $matrices[$shffld4[4]+3]\) $SPACE$SPACE$SPACE$SPACE', ans_rule(2) ])\}$BR
END_TEXT
Context()->normalStrings;

ANS(Compute("$nilp_data[$shffld3[0]][0]")->cmp);
ANS(Compute("$nilp_data[$shffld3[1]][0]")->cmp);
ANS(Compute("$nilp_data[$shffld3[2]][0]")->cmp);
ANS(Compute("$nilp_data[$shffld4[0]+3][0]")->cmp);
ANS(Compute("$nilp_data[$shffld4[1]+3][0]")->cmp);
ANS(Compute("$nilp_data[$shffld4[2]+3][0]")->cmp);
ANS(Compute("$nilp_data[$shffld4[3]+3][0]")->cmp);
ANS(Compute("$nilp_data[$shffld4[4]+3][0]")->cmp);



ENDDOCUMENT() ;
