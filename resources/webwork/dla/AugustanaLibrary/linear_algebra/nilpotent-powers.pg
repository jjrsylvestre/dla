## KEYWORDS('matrix forms','matrices','nilpotent')

## DBsubject('Linear Algebra')
## DBchapter('Matrices')
## DBsection('Matrix Preliminaries')
## Date('Feb 2015')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Campus')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
