## DESCRIPTION
## Linear Algebra
## ENDDESCRIPTION

## KEYWORDS('matrix' 'eigenvalues')

## DBsubject('Linear Algebra')
## DBchapter('Matrices')
## DBsection('Eigenvalues')
## Date('Feb 2015')
## Author('J. Sylvestre')
## Institution('University of Alberta, Augustana Campus')
## TitleText1('')
## EditionText1('')
## AuthorText1('')
## Section1('')
## Problem1('')

## BASED ON
## Library/Rochester/setLinearAlgebra13ComplexEigenvalues/ur_la_13_4.pg
##
## REASON FOR REWRITE
## Can sometimes get ridiculous numbers instead of 0.
## Could just round entries, but will just convert to a Math Object question instead


DOCUMENT();        # This should be the first executable line in the problem.

loadMacros(
  "PGstandard.pl",
  "MathObjects.pl",
  "PGmatrixmacros.pl",  # for mbox
#  "answerHints.pl",
);

TEXT(beginproblem());
$showPartialCorrectAnswers = 1;

Context("Complex");

# four complex eigenvalues 

$c1 = non_zero_random(1,2,1);
$d1 = random(2,4,1);
$e1 = random(-4,-3,1);

# complex eigenvalues are +- sqrt(-c1^2-d1e1) i 

$c2 = non_zero_random(1,2,1); 
$d2 = random(2,4,1);
$e2 = random(-4,-3,1);

# complex eigenvalues are +- sqrt(-c2^2-d2e2) i

#make sure eigenvalues are distinct: 

if ($c2*$c2 + $d2*$e2 == $c1*$c1 + $d1*$e1) {
	$e2 = $e2-1; 
} 

$B = Matrix([
	[$c1,$d1,0,0],
	[$e1,- $c1,0,0],
	[0,0,$c2,$d2],
	[0,0,$e2,- $c2],
]);

# now create a nonsingular matrix with det +-1:

$a[0][0] = random(-1,1,2);
$a[0][1] = random(0,1,1)*random(-1,1,2);
$a[0][2] = random(0,1,1)*random(-1,1,2);
$a[0][3] = random(0,1,1)*random(-1,1,2);

$b[1][0] = 0;
$b[1][1] = random(-1,1,2);
$b[1][2] = random(0,1,1)*random(-1,1,2);
$b[1][3] = random(0,1,1)*random(-1,1,2);

$b[2][0] = 0;
$b[2][1] = 0;
$b[2][2] = random(-1,1,2); 
$b[2][3] = random(0,1,1)*random(-1,1,2);

$b[3][0] = 0;
$b[3][1] = 0;
$b[3][2] = 0;
$b[3][3] = random(-1,1,2);

$k = random(0,1,1)*random(-1,1,2);
$l = random(0,1,1)*random(-1,1,2);
$m = random(0,1,1)*random(-1,1,2);
$n = random(0,1,1)*random(-1,1,2);
$p = random(0,1,1)*random(-1,1,2);
$q = random(0,1,1)*random(-1,1,2);

foreach $i (0..3) { 
	$a[1][$i] = $b[1][$i] + $k*$a[0][$i];
	$a[2][$i] = $b[2][$i] + $l*$a[0][$i] + $m*$a[1][$i]; 
	$a[3][$i] = $b[3][$i] + $n*$a[0][$i] + $p*$a[1][$i] + $q*$a[2][$i];
}

$A = Matrix(@a);
$M = $A * $B * ($A->inverse);


Context()->texStrings;
BEGIN_TEXT

Find all the eigenvalues (real and complex) of the matrix 
$BR
\(M= $M \)
$BR
Enter your answers in the following blank, separated by commas: 
$BR 
\{ans_rule(50)\} 

END_TEXT
Context()->normalStrings;

$ans = List(
	Complex(0,"sqrt(- $c1*$c1 - $d1*$e1)"),
	Complex(0,"-sqrt(- $c1*$c1 - $d1*$e1)"),
	Complex(0,"sqrt(- $c2*$c2 - $d2*$e2)"),
	Complex(0,"-sqrt(- $c2*$c2 - $d2*$e2)"),
);

ANS( $ans->cmp(partialCredit=>1) );

ENDDOCUMENT();       # This should be the last executable line in the problem.

