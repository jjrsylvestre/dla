## Problem1('')


DOCUMENT();
loadMacros("PGbasicmacros.pl",
        "PGchoicemacros.pl",
        "PGanswermacros.pl",

);
TEXT(beginproblem());

$showPartialCorrectAnswers = 0;
# Make a new select list
$sel_list = new_select_list();
# $sel_list now "contains" the select list object.

# change the printing mechanism of the object to
# use pop-up list instead of an answer rule.
$sel_list->rf_print_q(~~&pop_up_list_print_q);

# set pop-up list entries
$sel_list->ra_pop_up_list( [ No_answer => "$SPACE$SPACE$SPACE$SPACE ?", I => "Always Independent", S => "Sometimes Independent", D => "Never Independent"] );

# set up the pop-up list object
$sel_list -> qa (
"$SPACE$SPACE Two distinct lines. $BR", "I",
"$SPACE$SPACE Two distinct planes. $BR", "D",
"$SPACE$SPACE Three distinct lines. $BR", "S",
"$SPACE$SPACE A plane and a line. $BR", "S",
"$SPACE$SPACE A plane and two distinct lines. $BR", "D",

);
$sel_list->choose(5);


BEGIN_TEXT
In each of the following, decide whether the given collection of subspaces of \(\mathbb{R}^3\) form a collection that must always be independent, can sometimes be independent but sometimes not (depending on the actual subspaces), or can never be independent.
$PAR
$BBOLD In this question you should assume that all lines and planes under consideration pass through the origin. $EBOLD
$PAR
$BBOLD Note: $EBOLD "Distinct" means "not the same".
\{ $sel_list->print_q \}
END_TEXT
# Enter the correct answers to be checked against the answers to the students.
ANS(str_cmp( $sel_list->ra_correct_ans )   ) ;

ENDDOCUMENT();
